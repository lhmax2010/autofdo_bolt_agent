@@ -14,10 +14,18 @@
 #include "llvm/Support/Error.h"
 #include "llvm/Support/ErrorOr.h"
 #include "llvm/Support/WithColor.h"
+#include <functional>
 #include <system_error>
 
 namespace llvm {
 
+// Empty for the legacy path. Move the callback before invocation so even a
+// failure while reporting cannot reenter it.
+inline std::function<void(StringRef)> ProfgenExitCallback;
+inline void setProfgenExitCallback(std::function<void(StringRef)> Callback) {
+  ProfgenExitCallback = std::move(Callback);
+}
+
 [[noreturn]] inline void exitWithError(const Twine &Message,
                                        StringRef Whence = StringRef(),
                                        StringRef Hint = StringRef()) {
@@ -27,6 +35,11 @@ namespace llvm {
   errs() << Message << "\n";
   if (!Hint.empty())
     WithColor::note() << Hint.str() << "\n";
+  if (ProfgenExitCallback) {
+    auto Callback = std::move(ProfgenExitCallback);
+    ProfgenExitCallback = nullptr;
+    Callback((Whence.empty() ? Message : Twine(Whence) + ": " + Message).str());
+  }
   ::exit(EXIT_FAILURE);
 }
 
@@ -36,6 +49,10 @@ namespace llvm {
 }
 
 [[noreturn]] inline void exitWithError(Error E, StringRef Whence) {
+  // IP's registered handler also covers StringError values that cannot be
+  // converted to error_code. Keep the legacy conversion untouched otherwise.
+  if (ProfgenExitCallback)
+    exitWithError(toString(std::move(E)), Whence);
   exitWithError(errorToErrorCode(std::move(E)), Whence);
 }
 
