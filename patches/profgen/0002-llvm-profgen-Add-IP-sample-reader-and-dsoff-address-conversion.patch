 #include "llvm/Support/CommandLine.h"
 #include "llvm/Support/FileSystem.h"
@@ -79,6 +81,82 @@ static cl::opt<std::string> DataAccessProfileFilename(
              "-D`) consisting of memory access events."),
     cl::cat(ProfGenCategory));
 
+static cl::opt<bool> IPSamples(
+    "ip-samples", cl::init(false),
+    cl::desc("Read IP-only perf script samples (profile generation pending)"),
+    cl::cat(ProfGenCategory));
+static cl::opt<std::string> IPEvent(
+    "ip-event",
+    cl::desc("Select the complete perf event name, including modifiers"),
+    cl::cat(ProfGenCategory));
+static cl::opt<std::string> BinaryMatchRegex(
+    "binary-match-regex",
+    cl::desc("Select IP sample DSO paths by regular expression"),
+    cl::cat(ProfGenCategory));
+static cl::opt<bool> ShowIPAddressCounts(
+    "show-ip-address-counts", cl::Hidden,
+    cl::desc("Print IP address counters and reader statistics"),
+    cl::cat(ProfGenCategory));
+
+static Error runIPMode() {
+  auto Fail = [](const Twine &Message) {
+    return createStringError(inconvertibleErrorCode(), Message);
+  };
+  if (!IPSamples)
+    return Fail("IP-only options require --ip-samples");
+  SmallVector<StringRef, 32> Rejected;
+  for (const auto &Entry : cl::getRegisteredOptions()) {
+    StringRef Name = Entry.first;
+    if (!Entry.second->getNumOccurrences())
+      continue;
+    bool Forbidden =
+        Name.starts_with("csprof-") || Name.starts_with("csspgo-") ||
+        StringSwitch<bool>(Name)
+            .Cases({"unsymbolized-profile", "llvm-sample-profile"}, true)
+            .Cases({"skip-symbolization", "data-access-perftrace"}, true)
+            .Cases({"ignore-stack-samples", "use-context-cost-for-preinliner"},
+                   true)
+            .Cases({"max-search-depth", "gen-cs-nested-profile"}, true)
+            .Cases({"compress-recursion", "mark-all-context-preinlined"}, true)
+            .Cases({"use-offset", "use-first-loadable-segment-as-base"}, true)
+            .Cases({"update-total-samples", "fill-zero-for-all-funcs"}, true)
+            .Cases({"populate-profile-symbol-list", "kernel"}, true)
+            .Cases({"show-disassembly-only", "disassemble-functions"}, true)
+            .Cases({"show-source-locations", "show-canonical-fname"}, true)
+            .Cases({"show-pseudo-probe", "infer-missing-frames"}, true)
+            .Default(false);
+    if (Forbidden)
+      Rejected.push_back(Name);
+  }
+  llvm::sort(Rejected);
+  if (!Rejected.empty())
+    return Fail("option --" + Rejected.front() +
+                " is not supported with --ip-samples");
+  if (OutputFilename == "-")
+    return Fail("IP sample mode does not support --output=-");
+  if (PerfDataFilename.getNumOccurrences())
+    return Fail("IP sample mode: --perfdata is not admitted; use perf script "
+                "text exported on the board");
+  if (!PerfScriptFilename.getNumOccurrences())
+    return Fail("IP sample mode requires --perfscript");
+  IPReaderOptions Options;
+  if (IPEvent.getNumOccurrences())
+    Options.Event = IPEvent;
+  if (BinaryMatchRegex.getNumOccurrences())
+    Options.BinaryMatchRegex = BinaryMatchRegex;
+  if (ProcessId.getNumOccurrences())
+    Options.PID = ProcessId;
+  IPPerfReader Reader;
+  if (Error E = Reader.read(PerfScriptFilename, BinaryPath, Options))
+    return E;
+  if (ShowMmapEvents)
+    Reader.printMmapEvents(outs());
+  if (ShowIPAddressCounts)
+    Reader.printAddressCounts(outs());
+  // No writer and no output file are opened until profile generation exists.
+  return Fail("IP sample mode: profile generation is not implemented yet");
+}
