 test "$(llvm-config --version)" = "%{version}" || exit 1
 llvm_evr=""
 for p in llvm llvm-devel llvm-static-devel libllvm libomp; do
@@ -96,7 +101,7 @@ for p in llvm llvm-devel llvm-static-devel libllvm libomp; do
     fi
     llvm_evr=$e
