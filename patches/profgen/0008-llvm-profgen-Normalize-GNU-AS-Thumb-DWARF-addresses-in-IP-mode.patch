diff --git a/llvm/test/tools/llvm-profgen/Inputs/ip-mode/gnu-thumb/adjacent.s b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/gnu-thumb/adjacent.s
new file mode 100644
index 000000000000..ec9b83ad0b8a
--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/gnu-thumb/adjacent.s
@@ -0,0 +1,18 @@
+.syntax unified
+.arch armv7-a
+.text
+.thumb
+.global first
+.type first, %function
+.thumb_func
+first:
+  movs r0, #1
+  bx lr
+.size first, .-first
+.global second
+.type second, %function
+.thumb_func
+second:
+  movs r0, #2
+  bx lr
+.size second, .-second
diff --git a/llvm/test/tools/llvm-profgen/Inputs/ip-mode/gnu-thumb/check-normalization.py b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/gnu-thumb/check-normalization.py
new file mode 100644
index 000000000000..199cb82edbff
--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/gnu-thumb/check-normalization.py
@@ -0,0 +1,117 @@
+#===- check-normalization.py - Thumb DWARF address checks ------------------===#
+# Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+# See https://llvm.org/LICENSE.txt for license information.
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#===----------------------------------------------------------------------===#
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+TOOL, TMP = sys.argv[1:]
+TMP = Path(TMP)
+TMP.mkdir(parents=True, exist_ok=True)
+HERE = Path(__file__).resolve().parent
+sequence = 0
+
+
+def run(name, samples, flags, failure=None, stage="boundary"):
+
+    global sequence
+    sequence += 1
+    stem = TMP / str(sequence)
+    text = stem.with_suffix('.perfscript')
+    text.write_text(''.join(f'17/17 {period} cycles: {address:x} (/target+0x{address:x})\n'
+                            for address, period in samples))
+    output = stem.with_suffix('.prof')
+    report = stem.with_suffix('.json')
+    output.unlink(missing_ok=True)
+    p = subprocess.run([TOOL, '--ip-samples', '--allow-missing-build-id',
+                        '--binary-match-regex=^/target$',
+                        '--binary='+str(HERE/(name+'.perfbin')),
+                        '--perfscript='+str(text), '--output='+str(output),
+                        '--quality-report='+str(report), '--format=text',
+                        '--show-ip-address-counts', '--show-ip-boundaries',
+                        '--ip-period-unit=1', *flags], capture_output=True, text=True)
+    stem.with_suffix('.stdout').write_text(p.stdout)
+    stem.with_suffix('.stderr').write_text(p.stderr)
+    q = json.loads(report.read_text())
+    if failure:
+        assert p.returncode != 0 and failure in p.stderr, (name, p.stderr)
+        assert q['verdict']['failure_stage'] == stage, q
+        assert not output.exists()
+    else:
+        assert p.returncode == 0, p.stderr
+        assert 'IP-GENERATION outside_dwarf_func samples=0' in p.stdout
+    return p, q, output.read_text() if output.exists() else ''
+
+
+expected = {'function': 'gnu_thumb', 'original_begin': 4097,
+            'original_end': 4105, 'begin': 4096, 'end': 4104}
+for aggregation in ['sum', 'max', 'avg']:
+    p, q, profile = run('gnu-thumb', [(0x1000, 10), (0x1002, 20), (0x1006, 30)],
+                        ['--ip-aggregation='+aggregation])
+    n = q['thumb_dwarf_normalization']
+    assert n['range_count'] == 1 and n['top50'] == [expected], q
+    assert n['alias_query_count'] == n['alias_check_passed'] == 1, n
+    assert [x['address'] for x in n['alias_addresses_top50']] == [0x1000], n
+    assert any(w['code'] == 'W_THUMB_DWARF_ADDRESS_NORMALIZED' for w in q['warnings'])
+    assert profile.startswith('gnu_thumb:60:0\n'), profile
+    assert sorted(int(x) for x in re.findall(r'^ \d+: (\d+)$', profile, re.M)) == [10,20,30], profile
+    addresses = [int(x, 16) for x in re.findall(r'^IP-BOUNDARY instruction=(0x[0-9a-f]+)', p.stdout, re.M)]
+    assert addresses == ([0x1000, 0x1002, 0x1006] if aggregation == 'avg' else []), p.stdout
+p, q, profile = run('gnu-thumb', [(0x1006, 30)],
+                    ['--ip-aggregation=sum', '--ip-zero-fill=sampled-functions'])
+assert sorted(int(x) for x in re.findall(r'^ \d+: (\d+)$', profile, re.M)) == [0,0,30], profile
+p, q, profile = run('gnu-thumb', [(0x1006, 30)],
+                    ['--ip-aggregation=sum', '--ip-skid=prev-inst'])
+assert 'IP-GENERATION skid_unadjusted samples=0' in p.stdout
+# GAS auto-generated line table: movs line 9, add.w line 10, bx line 11;
+# no declaration line, so offsets equal source line numbers.
+assert ' 10: 30\n' in profile, profile
+for name, sample, reason, count in [('odd-arm',0x1002,'unaligned A32 range start',0),
+                                   ('odd-data',0x1002,'no runtime code section for DWARF range',0),
+                                   ('odd-middle',0x1006,'range starts inside a Thumb instruction',1)]:
+    p, q, _ = run(name, [(sample, 10)], ['--ip-aggregation=avg'], reason)
+    assert q['thumb_dwarf_normalization']['range_count'] == count, q
+# Sample PC bit zero is never cleared.
+run('gnu-thumb', [(0x1003, 10)], ['--ip-aggregation=avg'],
+    'sample is not an instruction start')
+# Adjacent raw ranges overlap the next function's first instruction by one byte.
+for agg in ['sum', 'max', 'avg']:
+    p, q, profile = run('adjacent', [(0x1000, 10), (0x1004, 20)],
+                        ['--ip-aggregation='+agg])
+    assert 'first:10:0\n 9: 10\n' in profile, profile
+    assert 'second:20:0\n 16: 20\n' in profile, profile
+    assert not any(line.startswith('  ') for line in profile.splitlines()), profile
+    n = q['thumb_dwarf_normalization']
+    assert n['alias_query_count'] == n['alias_check_passed'] == 2, n
+    assert [x['address'] for x in n['alias_addresses_top50']] == [0x1000,0x1004], n
+    second = n['alias_addresses_top50'][1]
+    assert 'function=first' in second['original_query'], second
+    assert 'function=second' in second['alias_query'], second
+p, q, _ = run('line-mismatch', [(0x1000, 10)], ['--ip-aggregation=sum'],
+              'Thumb DWARF alias line mismatch', stage='generate')
+n = q['thumb_dwarf_normalization']
+assert n['alias_query_count'] == 1 and n['alias_check_passed'] == 0, n
+assert not n['alias_addresses_top50'][0]['consistent']
+assert 'line=9' in p.stderr and 'line=10' in p.stderr and 'address=0x1000 alias=0x1001' in p.stderr, p.stderr
+assert q['verdict']['fallback_callback_count'] == 1
+# The same real metadata mismatch must atomically replace the report and retain
+# an existing profile, without leaving same-directory temporary files.
+stem = TMP / str(sequence)
+output = stem.with_suffix('.prof')
+report = stem.with_suffix('.json')
+output.write_text('old profile sentinel\n')
+report.write_text('{"verdict":{"conversion":"ok"}}\n')
+cmd = [TOOL, '--ip-samples', '--allow-missing-build-id',
+       '--binary-match-regex=^/target$', '--binary='+str(HERE/'line-mismatch.perfbin'),
+       '--perfscript='+str(stem.with_suffix('.perfscript')),
+       '--ip-aggregation=sum', '--output='+str(output), '--quality-report='+str(report)]
+p = subprocess.run(cmd, capture_output=True, text=True)
