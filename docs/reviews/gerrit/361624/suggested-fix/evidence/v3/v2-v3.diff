     -DBOLT_INCLUDE_TESTS=OFF \
     -DBOLT_TARGETS_TO_BUILD="%{bolt_targets}" \
     -DLLVM_INCLUDE_TESTS=OFF
@@ -133,8 +138,6 @@ cd bolt-build
