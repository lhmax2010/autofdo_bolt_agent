--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/counting-extra/head.c
@@ -0,0 +1,14 @@
+//===- head.c - Inline head-estimation fixture ----------------------------===//
+static volatile unsigned salt;
+static __attribute__((always_inline)) inline unsigned left(unsigned x) {
+  __asm__ volatile("add %w0, %w0, #1" : "+r"(x));
+  return salt + x * 3;
+}
+static __attribute__((always_inline)) inline unsigned right(unsigned x) {
+  __asm__ volatile("add %w0, %w0, #2" : "+r"(x));
+  return salt ^ (x * 7);
+}
+__attribute__((noinline)) unsigned both(unsigned x) {
+  unsigned r = x & 1 ? left(x) : right(x);
+  return r + salt;
+}
