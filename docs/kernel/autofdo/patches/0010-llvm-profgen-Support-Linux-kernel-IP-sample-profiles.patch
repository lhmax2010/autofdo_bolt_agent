--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/ip-kernel.test
@@ -0,0 +1,3 @@
+# REQUIRES: aarch64-registered-target, arm-registered-target
+# RUN: %python %S/Inputs/ip-mode/check-kernel-ip.py llvm-profgen llvm-objcopy llvm-mc %t | FileCheck %s
+# CHECK: PASS: kernel IP identity, address translation, filtering and DWARF
diff --git a/llvm/test/tools/llvm-profgen/ip-options.test b/llvm/test/tools/llvm-profgen/ip-options.test
index e0d591f0cca0..4d20fae5aef6 100644
--- a/llvm/test/tools/llvm-profgen/ip-options.test
+++ b/llvm/test/tools/llvm-profgen/ip-options.test
@@ -43,7 +43,7 @@
 # RUN: not llvm-profgen --binary=%S/Inputs/ip-mode/a64-multi-load.perfbin --output=%t.out --ip-samples --ip-aggregation=sum --format=gcc --populate-profile-symbol-list 2>&1 | FileCheck %s --check-prefix=OPT21
 # OPT21: option --populate-profile-symbol-list is not supported with --ip-samples
 # RUN: not llvm-profgen --binary=%S/Inputs/ip-mode/a64-multi-load.perfbin --output=%t.out --ip-samples --ip-aggregation=sum --format=gcc --kernel 2>&1 | FileCheck %s --check-prefix=OPT22
-# OPT22: option --kernel is not supported with --ip-samples
+# OPT22: IP sample mode requires --perfscript
