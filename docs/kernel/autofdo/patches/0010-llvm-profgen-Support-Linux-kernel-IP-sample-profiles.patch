 ``--perfdata`` is not admitted in IP mode. Export text on the recording system
 instead; matching perf version numbers alone do not establish cross-host
@@ -109,6 +110,56 @@ export equivalence. Example conversion::
     --perf-buildid-list=buildids.txt --ip-aggregation=sum \
     --format=extbinary --output=workload.prof --quality-report=quality.json
 
+Linux kernel IP profiles
+~~~~~~~~~~~~~~~~~~~~~~~~
+
+Pass both ``--ip-samples`` and ``--kernel`` to profile the main Linux kernel
+image. Record on the kernel to be profiled and use the matching, linked
+little-endian ARM32 or AArch64 ``vmlinux`` with its symbol table and DWARF
+(or a matching ``--debug-binary``). Preserve the recording's kernel mmap and
+GNU build ID. For example, with sufficient permissions to read the kernel
+reference symbol and collect system-wide samples::
+
+  perf record -a --buildid-mmap -e cycles -c 1000003 -o perf.data -- ./workload
+  LC_ALL=C perf script -i perf.data --show-mmap-events --show-lost-events -F pid,tid,event,period,ip,dsoff > ip.perfscript
+  perf buildid-list -i perf.data > buildids.txt
+  llvm-profgen --ip-samples --kernel --binary=vmlinux --perfscript=ip.perfscript \
+    --perf-buildid-list=buildids.txt --ip-aggregation=sum \
+    --format=extbinary --output=vmlinux.prof --quality-report=quality.json
+
+The perf kernel mmap must have PID -1 and be named
+``[kernel.kallsyms]_text`` or ``[kernel.kallsyms]_stext``. Its printed
+``pgoff`` is the runtime address of the named reference symbol. The tool uses
+the same symbol in ``vmlinux`` to translate sampled IPs, regardless of the
+mmap's printed permissions (which can be ``---p``). Sample DSOs and
+buildid-list entries can also use the bare ``[kernel.kallsyms]`` name.
+Identity uses the complete GNU build ID from the mmap or buildid-list and
+checks any supplied split debug image. ``--allow-missing-build-id`` retains
+the standard explicit waiver for missing evidence. Known conflicts are
+errors. ``--binary-match-regex`` is unavailable in kernel IP mode.
+
+Use a recording from one boot only. Conflicting kernel mmap ranges or
+relocations are rejected. Two boots of the same image at the same addresses
+cannot be distinguished from the exported text. Without ``--pid``, PID -1
+samples are included. Selecting a PID limits the profile to samples
+attributed to that PID and can omit kernel time in kworkers and IRQ handlers.
+
+The ordinary IP DWARF line and inline attribution uses the translated
+sampled PC, without a return-address decrement. Kernel modules, JIT/BPF
+code and unresolved DSOs are skipped. The report records
+``kernel_mmap`` and ``samples.kernel_ip`` in this mode. The latter includes
+target, module, user, special DSO and unknown-address counts after event
+and PID selection, and unknown-PID counts before the PID filter. It also
+records discarded mapping-symbol data, special executable sections (such as
+exception vectors, startup and exit code), and samples without a CU or usable
+line information. Kernel target IPs outside the kernel mmap or a file-backed
+executable PT_LOAD, or whose relocation overflows or underflows, are skipped
+and counted in ``samples.kernel_ip.outside_image`` (sample count and period
+sum). Conversion fails when this count exceeds 1% of the selected kernel
+target sample count. Ambiguous overlapping executable segments for ordinary
+code remain an error. Livepatch or guest kernel attribution is outside this
+mode.
+
 IP options
 ~~~~~~~~~~
 
diff --git a/llvm/test/tools/llvm-profgen/Inputs/ip-mode/check-kernel-ip.py b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/check-kernel-ip.py
new file mode 100644
index 000000000000..b01af5a10fd7
--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/check-kernel-ip.py
@@ -0,0 +1,298 @@
+"""Exercise the CLI using the checked-in synthetic ARM/AArch64 DWARF ELFs."""
+
+import json
+import re
+import struct
+import subprocess
+import sys
+from pathlib import Path
+
+profgen, objcopy, mc, tmp = sys.argv[1:]
+fixtures = Path(__file__).parent
+work = Path(tmp)
+work.mkdir(exist_ok=True)
+kernel = "[kernel.kallsyms]"
+a64_id = "80ef839e96fd9179728db73ba10c229a2637410c"
+arm_id = "0a930787032acb2d70e7f8317fc57fab6337acba"
+a64 = work / "a64"
+no_dwarf = work / "a64-no-dwarf"
+a32 = work / "arm"
+module = work / "example.ko"
+
+
+def exec_tool(args):
+    return subprocess.run([str(x) for x in args], text=True, capture_output=True)
+
+
+def checked(args):
+    p = exec_tool(args)
+    assert p.returncode == 0, (args, p.stdout, p.stderr)
+
+
+checked(
+    [
+        objcopy,
+        "--add-symbol=_text=.text.first:0,global",
+        "--add-symbol=_stext=.text.first:4,global",
+        fixtures / "a64-multi-load.perfbin",
+        no_dwarf,
+    ]
+)
+# Add a small DWARF4 CU and two line sequences to the synthetic two-load
+# ELF. The first subprogram covers both instructions but only the first has a
+# line; a valid sample at 0x10004 is therefore a no-line discard.
+abbrev = bytes([
+    1, 0x11, 1, 0x10, 0x17, 0x11, 0x01, 0x12, 0x06, 0, 0,
+    2, 0x2e, 0, 0x03, 0x08, 0x11, 0x01, 0x12, 0x06,
+    0x3a, 0x0b, 0x3b, 0x0b, 0, 0, 0,
+])
+
+
+def dwarf_length(data):
+    return struct.pack("<I", len(data)) + data
+
+cu = struct.pack("<HIBBIQI", 4, 0, 8, 1, 0, 0x10000, 0x20008)
+for pc, name in [(0x10000, "first"), (0x30000, "second")]:
+    cu += b"\x02" + name.encode() + b"\0" + struct.pack("<QIBB", pc, 8, 1, 1)
+info = dwarf_length(cu + b"\0")
+line_header = bytes([1, 1, 1, 0xfb, 14, 13,
+                     0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1])
+line_header += b"\0kernel.c\0\0\0\0\0"
+line_ops = b""
+for pc, size in [(0x10000, 4), (0x30000, 8)]:
+    line_ops += b"\0\x09\x02" + struct.pack("<Q", pc)
+    line_ops += bytes([1, 2, size, 0, 1, 1])  # copy; advance_pc; end_sequence
+line = dwarf_length(struct.pack("<H", 4) + dwarf_length(line_header) + line_ops)
+dwarf_args = []
+for section, content in [(".debug_abbrev", abbrev), (".debug_info", info),
+                         (".debug_line", line)]:
+    chunk = work / section
+    chunk.write_bytes(content)
+    dwarf_args.append(f"--add-section={section}={chunk}")
+checked([objcopy, *dwarf_args, no_dwarf, a64])
+
+checked(
+    [
+        objcopy,
+        "--add-symbol=_text=.text:0,global",
+        fixtures / "arm-count.perfbin",
+        a32,
+    ]
+)
+checked([mc, "-triple=armv7-none-linux-gnueabi", "-filetype=obj",
+         fixtures / "arm-literal.s", "-o", module])
+
+
+def mapping(start, length, anchor, ref="_text", build_id=a64_id):
+    identity = f"<{build_id}>" if build_id else "00:00 0 0"
+    return f"-1/0 PERF_RECORD_MMAP2 -1/0: [{start:#x}({length:#x}) @ {anchor:#x} {identity}]: ---p {kernel}{ref}"
+
+
+def sample(ip, pid="-1/0", period=7, dso=kernel):
+    return f"{pid} {period} cycles: {ip:x} ({dso})"
+
+
+def run(name, lines, *, binary=a64, options=(), error=None):
+    inp, out, report = (work / (name + ext) for ext in (".perf", ".prof", ".json"))
+    inp.write_text("\n".join(lines) + "\n")
+    out.write_bytes(b"old profile")
+    p = exec_tool(
+        [
+            profgen, "--kernel", "--ip-samples", f"--binary={binary}",
+            f"--perfscript={inp}", "--format=text", "--ip-aggregation=sum",
+            "--ip-weight=sample", "--show-ip-address-counts", f"--output={out}",
+            f"--quality-report={report}", *options,
+        ]
+    )
+    if error is None:
+        assert p.returncode == 0, (name, p.stdout, p.stderr, report.read_text())
+        assert out.read_bytes() != b"old profile"
+    else:
+        assert p.returncode != 0 and error in p.stderr, (name, p.stdout, p.stderr)
+        assert out.read_bytes() == b"old profile", name
+    addrs = {int(i, 16): int(n) for i, n in re.findall(
+        r"IP-ADDRESS 0x([0-9a-fA-F]+) sample_count=(\d+)", p.stdout
+    )}
+    return addrs, json.loads(report.read_text()), out.read_bytes()
+
+
+def counts(report, key):
+    return report["samples"]["kernel_ip"][key]["sample_count"]
+
+
+start = 0xFFFF800000010000
+length = 0x20008
+m = mapping(start, length, start + 4, ref="_stext")
+both = [m, mapping(start, length, start)]
+ks = sample(start, dso=kernel + "+0xdeadbeef")
+second = sample(start + 0x20004, pid="17/17")
+lines = both + [
+    ks, second, sample(0x8000, pid="17/17", dso="/tmp/user+0x20"),
+    sample(0x9000, dso=str(module)), sample(0x9100, dso="[bpf_prog_123]"),
+    sample(0x9200, dso="[unknown]"), sample(0x9300, dso="unknown"),
+    sample(0x9400, dso="/tmp/jit/jitted-123-1.so"),
+]
+addresses, report, profile = run("slide", lines)
+assert addresses == {0x10000: 1, 0x30004: 1}, addresses
+assert b"first:" in profile and b"second:" in profile, profile
+assert report["identity"]["grade"] == "verified"
+assert report["kernel_mmap"]["runtime_anchor"] == start + 4
+assert report["kernel_mmap"]["elf_anchor"] == 0x10004
+for key, n in dict(target=2, modules_skipped=1, user_samples=1,
+                   special_skipped=2, unknown_address=2, unknown_pid=6, outside_image=0).items():
+    assert counts(report, key) == n, (key, report)
+
+addresses, report, profile = run("pid", lines, options=["--pid=17"])
+assert addresses == {0x30004: 1}
+assert b"second:" in profile and b"first:" not in profile
+assert counts(report, "unknown_pid") == 6
+
+buildids = work / "buildids"
+buildids.write_text(f"{a64_id} {kernel}\n")
+zero = [mapping(0x10000, length, 0x10000, build_id=None), sample(0x10000),
+        sample(0x30004, pid="17/17")]
+addrs, report, _ = run("zero", zero, options=[f"--perf-buildid-list={buildids}"])
+assert addrs == {0x10000: 1, 0x30004: 1}
+assert report["identity"]["grade"] == "verified-path"
+run("missing-id", zero, error="missing build-id evidence")
+_, report, _ = run("waiver", zero, options=["--allow-missing-build-id"])
+assert report["identity"]["grade"] == "unverified"
+
+buildids.write_text(f"{a64_id} {kernel}\n{arm_id} {kernel}_stext\n")
+run("conflicting-list", lines, options=[f"--perf-buildid-list={buildids}",
+    "--allow-missing-build-id"], error="build-id mismatch")
+run("conflicting-mmap-id",
+    [m, mapping(start, length, start, build_id=arm_id), ks],
+    error="build-id mismatch")
+run("wrong-debug-id", lines,
+    options=[f"--debug-binary={fixtures / 'a64-pie.debug'}"],
+    error="build-id mismatch")
+run("wrong-debug-class", lines, options=[f"--debug-binary={a32}"],
+    error="kernel debug ELF class or machine mismatch")
+debug = work / "matching.debug"
+checked([objcopy, "--only-keep-debug", a64, debug])
+addrs, report, _ = run("matching-debug", lines, options=[f"--debug-binary={debug}"])
+assert addrs == {0x10000: 1, 0x30004: 1}
+assert report["identity"]["grade"] == "verified"
+_, report, _ = run("no-cu", lines, binary=no_dwarf, error="no usable samples")
+assert counts(report, "no_cu") == 2
+_, report, _ = run("no-line", lines + [sample(start + 4)])
+assert counts(report, "in_func_no_line") == 1
+
+run("missing-mmap", [ks], error="missing synthesized kernel mmap")
+run("unnamed-reference", [mapping(start, length, start, ref=""), ks],
+    error="requires a _text or _stext reference suffix")
+run("unknown-reference", [mapping(start, length, start, ref="_other"), ks],
+    error="requires a _text or _stext reference suffix")
+run("missing-elf-symbol", [m, ks], binary=fixtures / "a64-multi-load.perfbin",
+    error="missing ELF kernel anchor _stext")
+run("zero-anchor", [mapping(start, length, 0), ks],
+    error="missing runtime kernel anchor")
+run("anchor-outside-map", [mapping(start, length, start + length), ks],
+    error="runtime kernel anchor is outside the kernel mmap")
+run("other-boot", [m, mapping(start, length, start + 8, ref="_stext"), ks],
+    error="conflicting kernel mmap anchors or ranges")
+run("range-conflict", [m, mapping(start, length - 1, start), ks],
+    error="conflicting kernel mmap anchors or ranges")
+run("overflow-map", [mapping(0xFFFFFFFFFFFFFFF0, 0x20, start), ks],
+    error="counter overflow")
+# Count outside the mmap, between PT_LOADs and relocation underflow together.
+# Retain the original periods and use sample count for the gate.
+wide_map = mapping(0, start + length, start + 4, ref="_stext")
+outside_mmap = sample(start + length, period=11)
+segment_gap = sample(start + 0x1000, period=13)
+underflow = sample(1, period=17)
+addresses, report, _ = run(
+    "sparse-outside", [wide_map] + [ks] * 300 + [outside_mmap, segment_gap, underflow]
+)
+assert addresses == {0x10000: 300}, addresses
+outside = report["samples"]["kernel_ip"]["outside_image"]
+assert (outside["sample_count"], outside["period_sum"]) == (3, 41), outside
+assert counts(report, "unknown_address") == 0
+
+# At exactly 1% accept. One fewer valid sample crosses the threshold.
+_, report, _ = run("outside-at-limit", [m] + [ks] * 99 + [outside_mmap])
+assert counts(report, "outside_image") == 1
+_, report, _ = run(
+    "outside-over-limit", [m] + [ks] * 98 + [outside_mmap],
+    error="1/99 kernel target samples (1.010%) are outside the image (limit 1%)",
+)
+assert counts(report, "outside_image") == 1
+assert report["samples"]["kernel_ip"]["outside_image"]["period_sum"] == 11
+
+bad_anchor = mapping(start, length, start + 0x1004, ref="_stext")
+_, report, _ = run(
+    "wrong-slide", [bad_anchor] + [ks] * 99 + [sample(start + 0x1000)],
+    error="99/100 kernel target samples (99.000%) are outside the image (limit 1%). "
+          "Check the kernel anchor and vmlinux identity",
+)
+assert counts(report, "outside_image") == 99
+
+# Duplicate the first executable program header in the second one. The
+# threshold never admits a sample with two mappings for ordinary code.
+overlap = work / "a64-overlap"
+elf = bytearray(a64.read_bytes())
+phoff = struct.unpack_from("<Q", elf, 32)[0]
+phsize, phnum = struct.unpack_from("<HH", elf, 54)
+loads = [ph for ph in range(phoff, phoff + phsize * phnum, phsize)
+         if struct.unpack_from("<II", elf, ph) == (1, 5)]
+first, second_load = loads
+elf[second_load:second_load + phsize] = elf[first:first + phsize]
+overlap.write_bytes(elf)
+run("overlapping-segments", [m, ks], binary=overlap,
+    error="kernel IP matches multiple executable PT_LOAD segments")
+run("broken-trace", [m, "12/12 broken"], error="line 2: IP sample mode: invalid or zero period")
+run("module-as-binary", [m, ks], binary=module, error="must be a linked ELF image")
+
+# A32 high runtime VA, with known in-function $d and an executable .plt.
+arm_start = 0xC0001298
+arm_lines = [
+    mapping(arm_start, 0x198, arm_start, build_id=arm_id),
+    sample(0xC000139C), sample(0xC000138C), sample(0xC0001400),
+]
+addrs, report, txt = run("arm32", arm_lines, binary=a32)
+assert addrs == {0x139C: 1}, addrs
+assert b"main:" in txt, txt
+assert counts(report, "target") == 3
+assert counts(report, "mapping_data") == 1
+assert counts(report, "special_section") == 1
+# A large linked-minus-runtime slide may exceed the ARM32 address width.
+_, report, _ = run(
+    "arm32-overflow", [mapping(1, 0xFFFFFFFF, 1, build_id=arm_id)]
+    + [sample(0x105)] * 100 + [sample(0xFFFFFFF0, period=19)],
+    binary=a32,
+)
+assert counts(report, "outside_image") == 1
+assert report["samples"]["kernel_ip"]["outside_image"]["period_sum"] == 19
+run("arm32-width", [mapping(0xFFFFFF00, 0x200, arm_start, build_id=arm_id),
+                   sample(0xFFFFFF00)], binary=a32, error="exceeds the ELF address range")
+bad_class = work / "arm-wrong-machine"
+elf = bytearray(a32.read_bytes())
+elf[18:20] = (183).to_bytes(2, "little")
+bad_class.write_bytes(elf)
+run("arm32-wrong-machine", arm_lines, binary=bad_class,
+    error="requires ELF32 little-endian ARM or ELF64 little-endian AArch64")
+
+# Thumb state is found from ELF mapping symbols at the translated PC.
+thumb = work / "thumb"
+thumb_id = "dfbdeeb909bf09bf3e93c3327e627d6ad246ffe5"
+checked([objcopy, "--add-symbol=_text=.text:0,global",
+         fixtures / "thumb-count.perfbin", thumb])
+addresses, report, profile = run(
+    "thumb", [mapping(arm_start, 0x128, arm_start, build_id=thumb_id),
+              sample(0xC00012BE), sample(0xC0001340)], binary=thumb,
+)
+assert addresses == {0x12BE: 1}, addresses
+assert b"loop:" in profile, profile
+assert counts(report, "mapping_data") == 1
+
+# Parse a real perf 6.12 mmap and sampled-IP export. Its old build ID
+# intentionally fails against the synthetic ELF; no symbolization is attempted.
+old_trace = (fixtures / "kernel-perf-6.12.perfscript").read_text().splitlines()
+_, report, _ = run("old-parser-only", old_trace, binary=a32,
+                   error="build-id mismatch")
+assert report["verdict"]["failure_stage"] == "identity"
+assert report["kernel_mmap"]["runtime_anchor"] == 0xC0008000
+assert report["kernel_mmap"]["reference"] == "_text"
+assert counts(report, "target") == 4
+print("PASS: kernel IP identity, address translation, filtering and DWARF")
