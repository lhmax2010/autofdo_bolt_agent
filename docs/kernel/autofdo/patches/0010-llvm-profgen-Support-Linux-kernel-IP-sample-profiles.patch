diff --git a/llvm/tools/llvm-profgen/IPKernelAddress.h b/llvm/tools/llvm-profgen/IPKernelAddress.h
new file mode 100644
index 000000000000..80c73a3e3728
--- /dev/null
+++ b/llvm/tools/llvm-profgen/IPKernelAddress.h
@@ -0,0 +1,40 @@
+//===- IPKernelAddress.h - Kernel IP relocation -----------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_TOOLS_LLVM_PROFGEN_IPKERNELADDRESS_H
+#define LLVM_TOOLS_LLVM_PROFGEN_IPKERNELADDRESS_H
+
+#include <cstdint>
+#include <optional>
+
+namespace llvm {
+
+/// Translate an IP using the difference between two addresses of the same
+/// symbol. Use unsigned magnitudes so both high-half addresses and negative
+/// slides work without signed overflow or an overflowing intermediate sum.
+inline std::optional<uint64_t> translateKernelIP(uint64_t IP,
+                                                 uint64_t RuntimeAnchor,
+                                                 uint64_t LinkAnchor,
+                                                 uint64_t MaxAddress) {
+  if (IP > MaxAddress || RuntimeAnchor > MaxAddress || LinkAnchor > MaxAddress)
+    return std::nullopt;
+  if (RuntimeAnchor >= LinkAnchor) {
+    uint64_t Slide = RuntimeAnchor - LinkAnchor;
+    if (IP < Slide)
+      return std::nullopt;
+    return IP - Slide;
+  }
+  uint64_t Slide = LinkAnchor - RuntimeAnchor;
+  if (Slide > MaxAddress - IP)
+    return std::nullopt;
+  return IP + Slide;
+}
+
+} // namespace llvm
+
+#endif
