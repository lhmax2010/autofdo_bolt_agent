+IPQualityReport::IPQualityReport(IPQualityOptions O, const IPPerfReader &R,
+                                 const IPGenerationStatistics &S,
+                                 const IPGenerationOptions &G)
+    : Options(std::move(O)), Reader(R), Statistics(S), Generation(G) {
+  ActiveReport = this;
+  if (Options.MinUsable)
+    UsableCheck = "unknown";
+  if (Options.MinSamples)
+    SampleCheck = "unknown";
+  if (Options.MaxLost)
+    LostCheck = "unknown";
+  setProfgenExitCallback([this](StringRef Message) {
+    ++CallbackCount;
+    fail(Message);
+  });
+}
+IPQualityReport::~IPQualityReport() { finish(); }
+void IPQualityReport::finish() {
+  setProfgenExitCallback(nullptr);
+  if (!ProfileTemporary.empty()) {
+    sys::fs::remove(ProfileTemporary);
+    ProfileTemporary.clear();
+  }
+  ActiveReport = nullptr;
+}
+void IPQualityReport::warn(StringRef Code, StringRef Message) {
+  Warnings.try_emplace(Code.str(), Message.str());
+}
+Error IPQualityReport::validateOptions() {
+  auto Parse = [&](const std::optional<std::string> &Text,
+                   std::optional<Fraction> &F, StringRef Name) -> Error {
+    if (!Text)
+      return Error::success();
+    if (*Text == "0" || *Text == "1") {
+      F = Fraction{uint64_t((*Text)[0] - '0'), 1};
+      return Error::success();
+    }
+    StringRef S(*Text);
+    uint64_t N;
+    if (!S.consume_front("0.") || S.empty() || S.size() > 9 || !decimal(S, N))
+      return failure("--" + Name +
+                     " requires 0, 1, or 0. followed by 1-9 decimal digits");
+    uint64_t D = 1;
+    for (size_t I = 0; I < S.size(); ++I)
+      D *= 10;
+    F = Fraction{N, D};
+    return Error::success();
+  };
+  if (Error E = Parse(Options.MinUsable, MinUsable, "ip-min-usable-ratio"))
+    return E;
+  if (Error E = Parse(Options.MaxLost, MaxLost, "ip-max-lost-ratio"))
+    return E;
+  if (Options.MinSamples) {
+    uint64_t N;
+    if (!decimal(*Options.MinSamples, N))
+      return failure(
+          "--ip-min-target-samples requires a non-negative decimal uint64");
+    MinSamples = N;
+  }
+  static const StringRef Points[] = {
+      "profile-write",    "profile-flush",   "profile-close",
+      "profile-rename",   "report-write",    "report-flush",
+      "report-close",     "report-rename",   "symbolize",
+      "debug-open",       "runtime-open",    "invalid-image",
+      "runtime-metadata", "debug-open-load", "debug-metadata",
+      "context-create"};
+  if (!Options.Injection.empty() &&
+      !llvm::is_contained(Points, Options.Injection))
+    return failure("unknown --ip-test-inject-failure point");
+  return Error::success();
+}
+json::Value IPQualityReport::ratio(uint64_t N, uint64_t D) const {
+  if (!D)
+    return "unknown";
+  return json::Object{{"numerator", N}, {"denominator", D}};
+}
+json::Value IPQualityReport::count(const IPAddressCount &C) const {
+  return json::Object{{"sample_count", C.SampleCount},
+                      {"period_sum", C.PeriodSum},
+                      {"normalized_weight",
+                       PeriodKnown ? ratio(weight(C, Generation.SampleWeight),
+                                           Generation.PeriodUnit)
+                                   : json::Value("unknown")}};
+}
+Error IPQualityReport::checkThresholds() {
+  if (Reader.Parsed && Reader.Stats.LostRecords &&
+      Reader.Stats.LostCount > UINT64_MAX - Reader.Stats.Input)
+    return failure("LOST ratio denominator overflow");
+  auto Greater = [](uint64_t N, uint64_t D, Fraction F) {
+    return (APInt(128, N) * APInt(128, F.D))
+        .ugt(APInt(128, D) * APInt(128, F.N));
+  };
+  auto T = Reader.Layers.find("target");
+  if (MinSamples && Reader.Selected)
+    SampleCheck = Reader.Stats.Target < *MinSamples ? "failed" : "passed";
+  if (MinUsable && Statistics.Classified && T != Reader.Layers.end()) {
+    uint64_t N = weight(Statistics.OriginalUsable, Generation.SampleWeight),
+             D = weight(T->second, Generation.SampleWeight);
+    if (D)
+      UsableCheck =
+          Greater(MinUsable->N, MinUsable->D, {N, D}) ? "failed" : "passed";
+  }
+  if (MaxLost && Reader.Parsed && Reader.Stats.LostRecords) {
+    uint64_t L = Reader.Stats.LostCount, S = Reader.Stats.Input;
+    // A 65-bit denominator and two 64-bit factors fit in 192 bits.
+    auto Left = APInt(192, L) * APInt(192, MaxLost->D);
+    auto Right = (APInt(192, L) + APInt(192, S)) * APInt(192, MaxLost->N);
+    LostCheck = Left.ugt(Right) ? "exceeded" : "not_exceeded";
+  }
+  if (UsableCheck == "unknown")
+    warn("W_USABLE_RATIO_UNKNOWN", "configured usable ratio is unknown");
+  if (SampleCheck == "unknown")
+    warn("W_TARGET_COUNT_UNKNOWN", "configured target count is unknown");
+  if (LostCheck == "unknown")
+    warn("W_LOST_RATIO_UNKNOWN", "configured visible LOST ratio is unknown");
+  if (UsableCheck == "failed")
+    return failure("--ip-min-usable-ratio check failed");
+  if (SampleCheck == "failed")
+    return failure("--ip-min-target-samples check failed");
+  if (LostCheck == "exceeded")
+    return failure("--ip-max-lost-ratio check failed");
+  return Error::success();
+}
+
+// Diagnostic-only ELF inspection. Never promote failed metadata inspection to
+// a conversion error; boundary validation remains the authority when requested.
+void IPQualityReport::observeBinary() {
+  if (Options.Report.empty())
+    return;
+  struct Mapping {
+    uint64_t Address;
+    char State;
+  };
+  struct Symbol {
+    uint64_t Address, Size;
+    std::string Name;
+    bool Thumb, StaticTable;
+  };
+  struct Section {
+    uint64_t Address, Size;
+    std::vector<Mapping> Maps;
+  };
+  std::map<std::pair<std::string, uint64_t>, Section> Sections;
+  std::vector<Symbol> Symbols;
+  bool IsARM = false;
+  auto Inspect = [&](StringRef Path) {
+    auto Obj = ObjectFile::createObjectFile(Path);
+    if (!Obj) {
+      consumeError(Obj.takeError());
+      return;
+    }
+    auto *O = Obj->getBinary();
+    if (!isa<ELFObjectFileBase>(O))
+      return;
+    IsA64 = O->getArch() == Triple::aarch64;
+    bool ARM = O->getArch() == Triple::arm || O->getArch() == Triple::thumb;
+    IsARM = ARM;
+    for (const SectionRef &S : O->sections()) {
+      auto N = S.getName();
+      if (!N) {
+        consumeError(N.takeError());
+        continue;
+      }
+      if (S.isText())
+        Sections.try_emplace({N->str(), S.getAddress()},
+                             Section{S.getAddress(), S.getSize(), {}});
+    }
+    auto ReadSymbol = [&](const SymbolRef &S, bool AllowMapping) {
+      auto N = S.getName();
+      auto A = S.getAddress();
+      auto Sec = S.getSection();
+      auto F = S.getFlags();
+      if (!N || !A || !Sec || !F) {
+        if (!N)
+          consumeError(N.takeError());
+        if (!A)
+          consumeError(A.takeError());
+        if (!Sec)
+          consumeError(Sec.takeError());
+        if (!F)
+          consumeError(F.takeError());
+        return;
+      }
+      ELFSymbolRef ES(S);
+      if (ES.getELFType() == ELF::STT_FUNC &&
+          !(*F & (SymbolRef::SF_Undefined | SymbolRef::SF_Absolute)) &&
+          *Sec != O->section_end() && (*Sec)->isText())
+        Symbols.push_back({*A & (ARM ? ~uint64_t(1) : ~uint64_t(0)),
+                           ES.getSize(), N->str(),
+                           bool(*F & SymbolRef::SF_Thumb), AllowMapping});
+      if (!AllowMapping || *Sec == O->section_end() || !(*Sec)->isText())
+        return;
+      bool Name = N->size() >= 2 && (*N)[0] == '$' &&
+                  (N->size() == 2 || (N->size() > 3 && (*N)[2] == '.'));
+      if (!Name || ES.getELFType() != ELF::STT_NOTYPE ||
+          ES.getBinding() != ELF::STB_LOCAL)
+        return;
+      char State = (*N)[1];
+      if (!(State == 'd' || (ARM && (State == 'a' || State == 't')) ||
+            (IsA64 && State == 'x')))
+        return;
+      auto SN = (*Sec)->getName();
+      if (!SN) {
+        consumeError(SN.takeError());
+        return;
+      }
+      auto It = Sections.find({SN->str(), (*Sec)->getAddress()});
+      if (It != Sections.end() && *A >= It->second.Address &&
+          *A - It->second.Address < It->second.Size)
+        It->second.Maps.push_back({*A, State});
+    };
+    for (const SymbolRef &S : O->symbols())
+      ReadSymbol(S, true);
+    for (const SymbolRef &S :
+         cast<ELFObjectFileBase>(O)->getDynamicSymbolIterators())
+      ReadSymbol(S, false);
+  };
+  Inspect(Options.Binary);
+  if (!Options.Debug.empty())
+    Inspect(Options.Debug);
+  for (auto &[K, S] : Sections)
+    llvm::sort(S.Maps, [](auto A, auto B) {
+      return std::tie(A.Address, A.State) < std::tie(B.Address, B.State);
+    });
+  for (StringRef N : {"thumb", "a32", "a64", "unknown"})
+    ISACounts[N.str()] = {};
+  for (StringRef N : {"mapping-symbols", "SF_Thumb", "unknown"})
+    ISASources[N.str()] = {};
+  auto Add = [](IPAddressCount &A, const IPAddressCount &B) {
+    A.SampleCount += B.SampleCount;
+    A.PeriodSum += B.PeriodSum;
+  };
+  // All buckets are subsets of checked selected-event totals.
+  for (auto &[PC, C] : Reader.Counts) {
+    std::string ISA = "unknown", Source = "unknown";
+    unsigned Cover = 0;
+    bool HaveMap = false;
+    for (auto &[K, S] : Sections) {
+      if (PC < S.Address || PC - S.Address >= S.Size)
+        continue;
+      ++Cover;
+      auto It =
+          std::upper_bound(S.Maps.begin(), S.Maps.end(), PC,
+                           [](uint64_t P, Mapping M) { return P < M.Address; });
+      if (It == S.Maps.begin())
+        continue;
+      auto Last = std::prev(It);
+      bool Conflict = false;
+      for (auto J = Last; J != S.Maps.begin();) {
+        --J;
+        if (J->Address != Last->Address)
+          break;
+        if (J->State != Last->State)
+          Conflict = true;
+      }
+      HaveMap = true;
+      Source = "mapping-symbols";
+      if (!Conflict)
+        ISA = Last->State == 't'   ? "thumb"
+              : Last->State == 'a' ? "a32"
+              : Last->State == 'x' ? "a64"
+                                   : "unknown";
+    }
+    if (Cover > 1) {
+      ISA = "unknown";
+      Source = "unknown";
+      HaveMap = true;
+    }
+    if (!HaveMap && (IsA64 || IsARM))
+      for (const auto &S : Symbols)
+        if (PC >= S.Address && PC - S.Address < S.Size) {
+          ISA = IsA64 ? "a64" : S.Thumb ? "thumb" : "a32";
+          Source = "SF_Thumb";
+          break;
+        }
+    Add(ISACounts[ISA], C);
+    Add(ISASources[Source], C);
+    if (IsA64 && PC % 4 == 0) {
+      AlignmentCount += C.SampleCount;
+      AlignmentPeriod += C.PeriodSum;
+    }
+    if (Statistics.OutsideAddresses.count(PC)) {
+      std::string Name = "unknown";
+      for (const auto &S : Symbols)
+        if (S.StaticTable && PC >= S.Address && PC - S.Address < S.Size) {
+          Name = S.Name;
+          break;
+        }
+      Add(OutsideSymbols[Name], C);
+    }
+  }
+  ISAObserved = true;
+}
+
+json::Value IPQualityReport::build() {
+  json::Object Root;
+  Root["schema_version"] = uint64_t(1);
+  json::Array Args;
+  for (auto &A : Options.Arguments)
+    Args.push_back(A);
+  Root["tool"] = json::Object{{"version", LLVM_VERSION_STRING},
+                              {"arguments", std::move(Args)}};
+  Root["input"] = json::Object{{"path", Options.Trace},
+                               {"sha256", stringOrUnknown(Reader.InputHash)},
+                               {"projection", "ip-only"}};
+  json::Array Events;
+  for (auto &[Name, C] : Reader.EventCounts)
+    Events.push_back(json::Object{{"name", Name},
+                                  {"sample_count", C.SampleCount},
+                                  {"period_sum", C.PeriodSum}});
+  Root["event"] = json::Object{
+      {"selected", stringOrUnknown(Reader.SelectedEvent)},
+      {"type", "unknown"},
+      {"config", "unknown"},
+      {"before_filter", Reader.Parsed ? json::Value(std::move(Events))
+                                      : json::Value("unknown")}};
+  StringRef Event = StringRef(Reader.SelectedEvent).split(':').first;
+  StringRef Raw = Generation.SampleWeight ? "samples"
+                  : Event == "cycles"     ? "cycles"
+                  : Event == "cpu-clock"  ? "ns"
+                                          : "unknown";
+  Root["semantics"] = json::Object{
+      {"weight", Generation.SampleWeight ? "sample" : "period"},
+      {"raw_event_unit", Raw},
+      {"output_count_unit",
+       Generation.SampleWeight ? "samples" : "normalized-event-count"},
+      {"p_ref", PeriodKnown ? json::Value(Generation.PeriodUnit)
+                            : json::Value("unknown")},
+      {"p_ref_source", Generation.SampleWeight     ? "sample"
+                       : Generation.ExplicitPeriod ? "explicit"
+                                                   : "automatic"},
+      {"aggregation", Generation.AverageAggregation ? "avg"
+                      : Generation.MaxAggregation   ? "max"
+                                                    : "sum"},
+      {"dup_policy", Generation.MaxAggregation || Generation.AverageAggregation
+                         ? "duplication-factor"
+                         : "observed-sum"},
+      {"zero_fill", Generation.ZeroFill ? "sampled-functions" : "none"},
+      {"head_samples", Generation.EstimateHead ? "entry-estimate" : "none"},
+      {"skid", Generation.PrevInst ? "prev-inst" : "none"},
+      {"mode", "dwarf"},
+      {"fs_discriminator", Statistics.Started
+                               ? json::Value(Statistics.FSDiscriminator)
+                               : json::Value("unknown")}};
+  if (!SemanticsKnown)
+    Root["semantics"] = "unknown";
+  json::Array Candidates, Evidence;
+  for (auto &P : Reader.Candidates)
+    Candidates.push_back(json::Object{
+        {"path", P}, {"deleted", StringRef(P).ends_with(" (deleted)")}});
+  for (const auto &E : Reader.Evidence)
+    Evidence.push_back(json::Object{
+        {"path", E.Path},
+        {"source", E.Source},
+        {"build_id", E.ID},
+        {"result", E.Result},
+        {"mapping_index", E.MappingIndex ? json::Value(*E.MappingIndex)
+                                         : json::Value("unknown")}});
+  bool HasID =
+      llvm::any_of(Reader.Mappings, [](auto &M) { return !M.BuildID.empty(); });
+  Root["identity"] = json::Object{
+      {"observed_mmap_build_id",
+       Reader.Parsed ? json::Value(HasID) : json::Value("unknown")},
+      {"binary", Options.Binary},
+      {"binary_realpath", stringOrUnknown(Reader.BinaryRealPath)},
+      {"binary_build_id", Reader.BinaryIdentityRead
+                              ? json::Value(Reader.BinaryID)
+                              : json::Value("unknown")},
+      {"debug_binary", Options.Debug},
+      {"debug_build_id", Reader.DebugIdentityRead ? json::Value(Reader.DebugID)
+                                                  : json::Value("unknown")},
+      {"selection", Reader.ReadOptions.BinaryMatchRegex ? "regex" : "basename"},
+      {"candidates", Reader.Selected ? json::Value(std::move(Candidates))
+                                     : json::Value("unknown")},
+      {"evidence", Reader.BinaryIdentityRead ? json::Value(std::move(Evidence))
+                                             : json::Value("unknown")},
+      {"grade", Reader.IdentityGrade}};
+  uint64_t Exec = 0, NonExec = 0;
+  std::set<int64_t> PIDs;
+  json::Array Maps;
+  for (const auto &S : Reader.Samples)
+    if (S.PID >= 0)
+      PIDs.insert(S.PID);
+  for (const auto &M : Reader.Mappings)
+    if (Reader.Candidates.count(M.Path)) {
+      bool X = M.Permissions.find('x') != std::string::npos;
+      X ? ++Exec : ++NonExec;
+      Maps.push_back(
+          json::Object{{"pid", M.PID},
+                       {"tid", M.TID},
+                       {"path", M.Path},
+                       {"executable", X},
+                       {"build_id", M.BuildID},
+                       {"evidence_class", !M.BuildID.empty()  ? "mmap2-build-id"
+                                          : !M.Device.empty() ? "inode-tuple"
+                                                              : "missing"}});
+    }
+  Root["mapping"] = json::Object{
+      {"pid_count", Reader.Parsed ? json::Value(uint64_t(PIDs.size()))
+                                  : json::Value("unknown")},
+      {"candidate_executable_records",
+       Reader.Selected ? json::Value(Exec) : json::Value("unknown")},
+      {"candidate_nonexecutable_records",
+       Reader.Selected ? json::Value(NonExec) : json::Value("unknown")},
+      {"records",
+       Reader.Selected ? json::Value(std::move(Maps)) : json::Value("unknown")},
+      {"completeness", "unknown"}};
+  auto Layer = [&](StringRef N) -> json::Value {
+    auto I = Reader.Layers.find(N.str());
+    return Reader.Selected && I != Reader.Layers.end() ? count(I->second)
+                                                       : json::Value("unknown");
+  };
+  auto Gen = [&](StringRef N) -> json::Value {
+    auto I = Statistics.Counts.find(N.str());
+    return Statistics.Classified && I != Statistics.Counts.end()
+               ? count(I->second)
+               : json::Value("unknown");
+  };
+  auto Top = [&](const std::map<std::string, IPAddressCount> &Counts,
+                 size_t Limit, uint64_t Denom) -> json::Array {
+    std::vector<std::pair<std::string, IPAddressCount>> Rows(Counts.begin(),
+                                                             Counts.end());
+    llvm::sort(Rows, [&](const auto &A, const auto &B) {
+      auto X = weight(A.second, Generation.SampleWeight),
+           Y = weight(B.second, Generation.SampleWeight);
+      return X != Y ? X > Y : A.first < B.first;
+    });
+    json::Array A;
+    for (size_t I = 0; I < std::min(Limit, Rows.size()); ++I)
+      A.push_back(json::Object{
+          {"name", Rows[I].first},
+          {"counts", count(Rows[I].second)},
+          {"share",
+           ratio(weight(Rows[I].second, Generation.SampleWeight), Denom)}});
+    return A;
+  };
+  uint64_t TargetWeight =
+      Reader.Layers.count("target")
+          ? weight(Reader.Layers.at("target"), Generation.SampleWeight)
+          : 0;
+  json::Object Samples{
+      {"input_total", Reader.Parsed ? json::Value(json::Object{
+                                          {"sample_count", Reader.Stats.Input}})
+                                    : json::Value("unknown")}};
+  for (StringRef N : {"after_event", "after_pid", "pid_unknown", "kernel",
+                      "other_dso", "unmapped"})
+    Samples[N] = Layer(N);
+  uint64_t OtherWeight =
+      Reader.Layers.count("other_dso")
+          ? weight(Reader.Layers.at("other_dso"), Generation.SampleWeight)
+          : 0;
+  Samples["other_dso_top20"] =
+      Reader.Selected ? json::Value(Top(Reader.OtherDSOs, 20, OtherWeight))
+                      : json::Value("unknown");
+  Samples["target"] = json::Object{
+      {"counts", Layer("target")},
+      {"unmapped_in_target",
+       Reader.Mapped ? Layer("unmapped_in_target") : json::Value("unknown")},
+      {"outside_dwarf_func", Gen("outside_dwarf_func")},
+      {"plt", Gen("plt")},
+      {"in_cu_no_subprogram", Gen("in_cu_no_subprogram")},
+      {"no_cu", Gen("no_cu")},
+      {"outside_symtab_top20",
+       ISAObserved ? json::Value(Top(OutsideSymbols, 20, TargetWeight))
+                   : json::Value("unknown")},
+      {"in_func_no_line", Gen("in_func_no_line")},
+      {"usable", Statistics.Classified ? count(Statistics.OriginalUsable)
+                                       : json::Value("unknown")}};
+  Samples["written_positions"] = Statistics.Finished
+                                     ? json::Value(Statistics.WrittenPositions)
+                                     : json::Value("unknown");
+  Samples["skid_unadjusted"] = Gen("skid_unadjusted");
+  json::Object Reasons;
+  for (StringRef R : {"first_instruction", "range_gap", "data_or_state_change",
+                      "predecessor_no_line"})
+    Reasons[R] = Gen(("skid_unadjusted_" + R).str());
+  Samples["skid_unadjusted_reasons"] = std::move(Reasons);
+  Root["samples"] = std::move(Samples);
+  json::Object ISA, Source;
+  for (auto &[N, C] : ISACounts)
+    ISA[N] = json::Object{
+        {"counts", count(C)},
+        {"sample_ratio", ratio(C.SampleCount, Reader.Stats.Target)},
+        {"weight_ratio",
+         ratio(weight(C, Generation.SampleWeight), TargetWeight)}};
+  for (auto &[N, C] : ISASources)
+    Source[N] = count(C);
+  ISA["sources"] = std::move(Source);
+  Root["isa"] =
+      ISAObserved ? json::Value(std::move(ISA)) : json::Value("unknown");
+  json::Array Sources, Failures;
+  for (auto &S : Statistics.BoundarySources)
+    Sources.push_back(S);
+  for (auto &[N, R] : Statistics.BoundaryFailures)
+    Failures.push_back(json::Object{{"function", N}, {"reason", R}});
+  Root["boundaries"] = json::Object{
+      {"requested", Generation.needsBoundaries()},
+      {"function_count", Statistics.Started
+                             ? json::Value(Statistics.EnumeratedFunctions)
+                             : json::Value("unknown")},
+      {"sources", std::move(Sources)},
+      {"failures", std::move(Failures)}};
+  json::Value LostRatio = "unknown";
+  if (Reader.Parsed && Reader.Stats.LostRecords &&
+      Reader.Stats.LostCount <= UINT64_MAX - Reader.Stats.Input)
+    LostRatio = ratio(Reader.Stats.LostCount,
+                      Reader.Stats.LostCount + Reader.Stats.Input);
+  Root["lost"] = json::Object{
+      {"records", Reader.Parsed ? json::Value(Reader.Stats.LostRecords)
+                                : json::Value("unknown")},
+      {"L", Reader.Parsed && Reader.Stats.LostRecords
+                ? json::Value(Reader.Stats.LostCount)
+                : json::Value("unknown")},
+      {"S", Reader.Parsed ? json::Value(Reader.Stats.Input)
+                          : json::Value("unknown")},
+      {"exported_lost_ratio", std::move(LostRatio)},
+      {"scope", "input"},
+      {"source", "PERF_RECORD_LOST"},
+      {"count_unit", "records"},
+      {"completeness", "unknown"}};
+  Root["throttle"] = "unknown";
+  auto U = Statistics.OriginalUsable;
+  auto T = Reader.Layers.count("target") ? Reader.Layers.at("target")
+                                         : IPAddressCount{};
+  auto N = Statistics.Counts.count("in_func_no_line")
+               ? Statistics.Counts.at("in_func_no_line")
+               : IPAddressCount{};
+  Root["ratios"] =
+      Statistics.Classified
+          ? json::Value(json::Object{
+                {"target_usable_ratio",
+                 ratio(weight(U, Generation.SampleWeight),
+                       weight(T, Generation.SampleWeight))},
+                {"target_usable_sample_ratio",
+                 ratio(U.SampleCount, T.SampleCount)},
+                {"target_usable_period_ratio", ratio(U.PeriodSum, T.PeriodSum)},
+                {"line_resolution_ratio",
+                 ratio(weight(U, Generation.SampleWeight),
+                       weight(U, Generation.SampleWeight) +
+                           weight(N, Generation.SampleWeight))}})
+          : json::Value("unknown");
+  Root["sanity"] =
+      json::Object{{"dwarf_function_ratio",
+                    Statistics.Classified
+                        ? ratio(U.SampleCount + N.SampleCount, T.SampleCount)
+                        : json::Value("unknown")},
+                   {"aarch64_alignment_ratio",
+                    ISAObserved && IsA64 ? ratio(AlignmentCount, T.SampleCount)
+                                         : json::Value("unknown")}};
+  std::map<std::string, IPAddressCount> Merged;
+  for (auto &[Name, Origins] : Statistics.FunctionOrigins)
+    if (Origins.size() > 1)
+      Merged[Name] = Statistics.Functions.at(Name);
+  Root["coverage"] = json::Object{
+      {"sampled_functions",
+       Statistics.Classified
+           ? json::Value(uint64_t(Statistics.Functions.size()))
+           : json::Value("unknown")},
+      {"unique_addresses", Reader.Mapped
+                               ? json::Value(uint64_t(Reader.Counts.size()))
+                               : json::Value("unknown")},
+      {"top50", Statistics.Classified
+                    ? json::Value(Top(Statistics.Functions, 50,
+                                      weight(U, Generation.SampleWeight)))
+                    : json::Value("unknown")},
+      {"name_merged_functions", Statistics.Classified
+                                    ? json::Value(uint64_t(Merged.size()))
+                                    : json::Value("unknown")},
+      {"name_merged_top50",
+       Statistics.Classified
+           ? json::Value(Top(Merged, 50, weight(U, Generation.SampleWeight)))
+           : json::Value("unknown")}};
+  json::Array Hints;
+  if (!Generation.EstimateHead)
+    Hints.push_back("Keep profi enabled during compilation and linking; "
+                    "explicitly enable it at the LTO link step.");
+  Root["consumer_hints"] = std::move(Hints);
+  if (Reader.Stats.LostRecords)
+    warn("W_LOST_MAY_INCLUDE_SIDEBAND",
+         "visible lost records may include sideband; mapping completeness is "
+         "unknown");
+  if (Reader.Parsed && !Reader.Samples.empty() &&
+      llvm::all_of(Reader.Samples, [&](auto &S) {
+        return S.Period == Reader.Samples.front().Period;
+      }))
+    warn("W_CONSTANT_PERIOD", "all input periods are equal; variable-period "
+                              "weighting has not been demonstrated");
+  if (Reader.IdentityGrade == "unverified")
+    warn("W_IDENTITY_UNVERIFIED", "binary identity is not verified");
+  json::Array WA;
+  for (auto &[C, M] : Warnings)
+    WA.push_back(json::Object{{"code", C}, {"message", M}});
+  Root["warnings"] = std::move(WA);
+  Root["verdict"] = json::Object{
+      {"conversion", Failure.empty() ? "ok" : "failed"},
+      {"failure_stage",
+       Failure.empty() ? json::Value("unknown") : json::Value(FailedStage)},
+      {"reason",
+       Failure.empty() ? json::Value("unknown") : json::Value(Failure)},
+      {"identity", Reader.IdentityGrade},
+      {"usable_ratio_check", UsableCheck},
+      {"sample_threshold_check", SampleCheck},
+      {"lost_ratio_check", LostCheck},
+      {"sampling_adequacy", SampleCheck == "failed" || LostCheck == "exceeded"
+                                ? "insufficient"
+                                : "unknown"},
+      {"fallback_callback_count", CallbackCount}};
+  return Root;
+}
+
+Error IPQualityReport::writeReport() {
+  if (Options.Report.empty())
+    return Error::success();
+  SmallString<256> Temp;
+  int FD;
+  if (auto EC =
+          sys::fs::createUniqueFile(Options.Report + ".tmp-%%%%%%", FD, Temp)) {
+    ReportIOFailed = true;
+    return createStringError(EC,
+                             "IP quality report: cannot create temporary file");
+  }
+  scope_exit Cleanup([&] { sys::fs::remove(Temp); });
+  raw_fd_ostream OS(FD, true);
+  json::OStream JSON(OS, 2);
+  JSON.value(build());
+  OS << '\n';
+  bool InjectWrite = inject("report-write");
+  OS.flush();
+  bool InjectFlush = inject("report-flush");
+  OS.close();
+  auto EC = OS.error();
+  if (OS.has_error())
+    OS.clear_error();
+  if (InjectWrite || InjectFlush || inject("report-close"))
+    EC = std::make_error_code(std::errc::io_error);
+  if (!EC)
+    EC = inject("report-rename") ? std::make_error_code(std::errc::io_error)
+                                 : sys::fs::rename(Temp, Options.Report);
+  if (EC) {
+    ReportIOFailed = true;
+    return createStringError(
+        EC,
+        "IP quality report: write/close/commit failed; old report preserved");
+  }
+  return Error::success();
+}
+Error IPQualityReport::commitReport() {
+  enter("write");
+  return writeReport();
+}
+void IPQualityReport::fail(StringRef Message) {
+  Failure = Message.str();
+  FailedStage = Stage;
+  if (UsableCheck == "unknown")
+    warn("W_USABLE_RATIO_UNKNOWN",
+         "configured usable ratio was not available before failure");
+  if (SampleCheck == "unknown")
+    warn("W_TARGET_COUNT_UNKNOWN",
+         "configured target count was not available before failure");
+  if (LostCheck == "unknown")
+    warn("W_LOST_RATIO_UNKNOWN",
+         "configured visible LOST ratio was not available before failure");
+  if (!ProfileTemporary.empty()) {
+    sys::fs::remove(ProfileTemporary);
+    ProfileTemporary.clear();
+  }
+  if (!ReportIOFailed)
+    if (Error E = writeReport())
+      errs() << "llvm-profgen: could not write failure quality report: "
+             << toString(std::move(E)) << '\n';
+}
