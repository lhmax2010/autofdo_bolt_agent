+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/quality/README.txt
@@ -0,0 +1,24 @@
+Quality report/failure fixtures, design 5.6 and 5.10; synthetic, no board input.
+Tools: Tizen GBS x86_64 LLVM 22.1.8 llvm-objcopy and readelf.
+truncated.debug: from ../a64-pie.debug, .debug_info first 500 of 501 bytes.
+  llvm-objcopy --dump-section=.debug_info=info ../a64-pie.debug
+  python3 -c 'from pathlib import Path; p=Path("info"); p.write_bytes(p.read_bytes()[:500])'
+  llvm-objcopy --update-section=.debug_info=info ../a64-pie.debug truncated.debug
+Other sections including build-id unchanged. Original CU length preserved.
+LLVM emits its original warning and ignores the CU; this is not an Error from
+symbolizeInlinedCode. Test ordinary generate failure separately from injection.
+invalid-symbol.perfbin: from ../a64-pie.perfbin. readelf -SW gives .symtab file
+ offset and entry size (ELF64, 24 bytes). Change .symtab[1].st_name to 0xffffffff
+ in little endian; no other byte changed. ELF load/identity still succeed;
+ ProfiledBinary's real loadIPMetadata -> unwrapOrError fails, without injection.
+All outputs in check-quality.py are under the lit temporary directory.
+invalid-symbol.debug uses the same st_name mutation on ../a64-pie.debug.
+This exercises the separate debug metadata unwrap without injection.
+thumb-fallback.perfbin: llvm-objcopy --strip-symbols=mapping-names.txt
+ ../thumb-count.perfbin thumb-fallback.perfbin; mapping-names.txt contains
+ $a, $d, $t. Function SF_Thumb remains; code/debug/build-id unchanged.
+thumb-absolute.perfbin: from thumb-fallback.perfbin. GBS readelf -SW/-sW
+locates ELF32 count_loop at .symtab index 4 and .dynsym index 1. Change
+only both st_shndx (entry+14, 2 little-endian bytes) from section 9
+to SHN_ABS (0xfff1).
+The apparent function extent must not provide SF_Thumb ISA evidence.
diff --git a/llvm/test/tools/llvm-profgen/Inputs/ip-mode/quality/check-quality.py b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/quality/check-quality.py
new file mode 100644
index 000000000000..7445b5a42374
--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/quality/check-quality.py
@@ -0,0 +1,262 @@
+#===- check-quality.py - IP quality contract checks ----------------------===#
+# Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+# See https://llvm.org/LICENSE.txt for license information.
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#===----------------------------------------------------------------------===#
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+TOOL, GROUP, TMP = sys.argv[1:]
+TMP = Path(TMP)
+TMP.mkdir(parents=True, exist_ok=True)
+HERE = Path(__file__).resolve().parent
+I = HERE.parent
+SEQ = 0
+DATA = '17/17 2 cycles: 1318 (/target+0x318)\n'
+OLD = b'old profile must remain\n'
+OLD_REPORT = b'{"verdict":{"conversion":"ok"}}\n'
+
+
+def run(extra=(), data=DATA, binary=None, expect=0, stage=None, old=False,
+        report_preserved=False, label=None):
+    global SEQ
+    SEQ += 1
+    d = TMP / (label or str(SEQ))
+    d.mkdir(exist_ok=True)
+    perf, out, report = d/'input.perfscript', d/'out.prof', d/'report.json'
+    perf.write_text(data)
+    out.unlink(missing_ok=True)
+    report.write_bytes(OLD_REPORT)
+    if old:
+        out.write_bytes(OLD)
+    cmd = [TOOL, '--ip-samples', '--allow-missing-build-id',
+           '--binary-match-regex=^/target$', '--ip-aggregation=sum',
+           '--ip-period-unit=1', '--format=text', '--binary='+str(binary or I/'a64-pie.perfbin'),
+           '--perfscript='+str(perf), '--output='+str(out),
+           '--quality-report='+str(report), *extra]
+    p = subprocess.run(cmd, capture_output=True, text=True)
+    (d/'stdout').write_text(p.stdout)
+    (d/'stderr').write_text(p.stderr)
+    assert (p.returncode == 0) == (expect == 0), (cmd, p.returncode, p.stderr)
+    assert 'LLVM ERROR' not in p.stderr and 'Stack dump' not in p.stderr, p.stderr
+    assert not list(d.glob('*.tmp-*')), list(d.iterdir())
+    if expect:
+        assert out.read_bytes() == OLD if old else not out.exists()
+    if report_preserved:
+        assert report.read_bytes() == OLD_REPORT, report.read_text()
+        return p, None, d, cmd
+    q = json.loads(report.read_text())
+    assert q['verdict']['conversion'] == ('failed' if expect else 'ok'), q
+    if stage:
+        assert q['verdict']['failure_stage'] == stage, q['verdict']
+    return p, q, d, cmd
+
+
+def ratio(n, d):
+    return {'numerator': n, 'denominator': d}
+
+
+def no_floats(x):
+    assert not isinstance(x, float), x
+    if isinstance(x, dict):
+        for v in x.values(): no_floats(v)
+    if isinstance(x, list):
+        for v in x: no_floats(v)
+
+
+if GROUP == 'fields':
+    data = (DATA + '17/17 3 cycles: 131c (/target+0x31c)\n'
+            '17/17 7 cpu-clock: 1318 (/target+0x318)\n'
+            '-1/-1 11 cycles: 1 ([kernel.kallsyms]+0x1)\n'
+            '17/17 13 cycles: 2 ([vdso]+0x2)\n'
+            '17/17 17 cycles: 3 ([unknown])\n'
+            '17/17 19 cycles: 4 (/other+0x4)\n'
+            '17/17 23 cycles: 9999 (/target+0x9999)\n'
+            '17/17 PERF_RECORD_LOST lost 3\n')
+    p,q,d,cmd = run(['--ip-event=cycles'],data)
+    assert set(q) == set('schema_version tool input event semantics identity mapping samples isa boundaries lost throttle ratios sanity coverage consumer_hints warnings verdict'.split())
+    assert q['input']['projection']=='ip-only' and len(q['input']['sha256'])==64
+    assert q['event']['type']==q['event']['config']=='unknown'
+    assert q['event']['before_filter']==[
+        {'name':'cpu-clock','sample_count':1,'period_sum':7},
+        {'name':'cycles','sample_count':7,'period_sum':88}]
+    s=q['samples'];assert s['input_total']=={'sample_count':8}
+    for name,n,w in [('after_event',7,88),('after_pid',7,88),('pid_unknown',1,11),('kernel',1,11),('other_dso',2,32),('unmapped',1,17)]:
+        assert s[name]['sample_count']==n and s[name]['period_sum']==w,(name,s[name])
+    t=s['target'];assert t['counts']['sample_count']==3 and t['counts']['period_sum']==28
+    assert t['unmapped_in_target']['sample_count']==1
+    assert t['usable']['sample_count']==2 and t['usable']['period_sum']==5
+    assert q['ratios']['target_usable_ratio']==ratio(5,28)
+    assert q['ratios']['target_usable_sample_ratio']==ratio(2,3)
+    assert q['lost']['records']==1 and q['lost']['L']==3 and q['lost']['S']==8
+    assert q['lost']['exported_lost_ratio']==ratio(3,11)
+    assert q['lost']['completeness']==q['mapping']['completeness']=='unknown'
+    assert 'W_LOST_MAY_INCLUDE_SIDEBAND' in [w['code'] for w in q['warnings']]
+    assert q['coverage']['sampled_functions']==1
+    assert q['coverage']['name_merged_functions']==0
+    assert q['isa']['a64']['counts']['sample_count']==2
+    no_floats(q)
+    profile=(d/'out.prof').read_bytes(); report=(d/'report.json').read_bytes()
+    p2=subprocess.run(cmd,capture_output=True,text=True);assert p2.returncode==0
+    assert profile==(d/'out.prof').read_bytes() and report==(d/'report.json').read_bytes()
+    for agg in ['sum','max','avg']:
+        p,r,_,_=run(['--ip-aggregation='+agg],DATA+'17/17 198 cycles: 9999 (/target+0x9999)\n')
+        assert r['ratios']['target_usable_ratio']==ratio(2,200)
+    p,r,_,_=run(['--trim-cold-profile','--profile-summary-cold-count=1000'],expect=1,stage='generate')
+    assert r['ratios']['target_usable_ratio']==ratio(2,2)
+    for name,isa in [('thumb-count','thumb'),('arm-count','a32')]:
+        addr,off=(0x12be,0x2be) if isa=='thumb' else (0x12c8,0x2c8)
+        p,r,_,_=run(data=f'17/17 2 cycles: {addr:x} (/target+0x{off:x})\n',binary=I/(name+'.perfbin'))
+        assert r['isa'][isa]['counts']['sample_count']==1
+    p,r,_,_=run(['--ip-period-unit=100'])
+    assert r['samples']['target']['usable']['normalized_weight']==ratio(2,100)
+    assert r['samples']['target']['usable']['sample_count']==1
+    p,r,_,_=run(['--ip-weight=sample'],DATA, expect=1)
+    assert 'has no effect with --ip-weight=sample' in p.stderr
+    p,r,_,_=run(data='17/17 2 cycles: 12be (/target+0x2be)\n',binary=HERE/'thumb-fallback.perfbin')
+    assert r['isa']['thumb']['counts']['sample_count']==1
+    assert r['isa']['sources']['SF_Thumb']['sample_count']==1
+    p,r,_,_=run(data='17/17 2 cycles: 12be (/target+0x2be)\n',binary=I/'thumb-count.stripped.perfbin',expect=1,stage='generate')
+    assert r['samples']['target']['outside_symtab_top20'][0]['name']=='unknown'
+    assert r['isa']['thumb']['counts']['sample_count']==1
+    assert r['isa']['sources']['SF_Thumb']['sample_count']==1
+    p,r,_,_=run(data='17/17 2 cycles: 12be (/target+0x2be)\n',binary=HERE/'thumb-absolute.perfbin')
+    assert r['isa']['unknown']['counts']['sample_count']==1
+    p,r,_,_=run(data='17/17 2 cycles: 1000 (/target+0x1000)\n',binary=I/'boundary-extra/bad-conflict.perfbin')
+    assert r['isa']['unknown']['counts']['sample_count']==1
+elif GROUP == 'thresholds':
+    p,q,_,_=run();v=q['verdict']
+    for n in ['usable_ratio_check','sample_threshold_check','lost_ratio_check']:assert v[n]=='not_evaluated'
+    assert v['sampling_adequacy']=='unknown'
+    for val in ['0','1','0.0','0.999999999']:
+        p,q,_,_=run(['--ip-min-usable-ratio='+val,'--ip-min-target-samples=1','--ip-max-lost-ratio='+val])
+        assert q['verdict']['usable_ratio_check']=='passed'
+        assert q['verdict']['sample_threshold_check']=='passed'
+        assert q['verdict']['lost_ratio_check']=='unknown'
+    for flag in ['ip-min-usable-ratio','ip-max-lost-ratio']:
+        for val in ['', '-0','-1','+0','1.0','1.1','0.1234567890','1e-1',' 0','0 ','0.','nan','2']:
+            p,q,_,_=run(['--'+flag+'='+val],expect=1,stage='parse',old=True)
+            assert '--'+flag in p.stderr
+    for val in ['-1','1.0','1e2','18446744073709551616','']:
+        p,q,_,_=run(['--ip-min-target-samples='+val],expect=1,stage='parse',old=True)
+        assert 'non-negative decimal uint64' in p.stderr
+    p,q,_,_=run(['--ip-min-target-samples=2'],expect=1,stage='generate',old=True)
+    assert q['verdict']['sample_threshold_check']=='failed' and q['verdict']['sampling_adequacy']=='insufficient'
+    p,q,_,_=run(['--ip-min-usable-ratio=0.5'],DATA+'17/17 3 cycles: 9999 (/target+0x9999)\n',expect=1,stage='generate')
+    assert q['verdict']['usable_ratio_check']=='failed'
+    for val,status,rc in [('0','exceeded',1),('0.5','not_exceeded',0),('1','not_exceeded',0)]:
+        p,q,_,_=run(['--ip-max-lost-ratio='+val],DATA+'17/17 PERF_RECORD_LOST lost 1\n',expect=rc,stage='generate' if rc else None)
+        assert q['verdict']['lost_ratio_check']==status
+    p,q,_,_=run(data='17/17 2 cycles: 1318 (/other+0x318)\n',expect=1)
+    assert 'no target samples' in p.stderr
+    assert q['verdict']['sample_threshold_check']=='not_evaluated'
+    p,q,_,_=run(['--ip-min-usable-ratio=0.1','--ip-min-target-samples=1','--ip-max-lost-ratio=0.1'],data='bad\n',expect=1,stage='parse')
+    assert all(q['verdict'][n]=='unknown' for n in ['usable_ratio_check','sample_threshold_check','lost_ratio_check'])
+    p,q,_,_=run(['--unknown-quality-test-option'],expect=1,stage='parse',old=True)
+    assert 'Unknown command line argument' in p.stderr
+    assert q['semantics']=='unknown'
+    assert q['coverage']['top50']=='unknown'
+    assert q['mapping']['records']=='unknown'
+    assert q['identity']['candidates']=='unknown'
+    assert q['event']['before_filter']=='unknown'
+    p,q,_,_=run(data='17/17 18446744073709551615 cycles: 1318 (/target+0x318)\n')
+    assert q['samples']['target']['usable']['period_sum']==18446744073709551615
+    no_floats(q)
+    p,q,_,_=run(data=DATA+'17/17 PERF_RECORD_LOST lost 18446744073709551615\n',expect=1,stage='generate',old=True)
+    assert 'LOST ratio denominator overflow' in p.stderr
+    assert q['lost']['exported_lost_ratio']=='unknown'
+elif GROUP == 'exits':
+    missing=TMP/'absent.perfbin'
+    missing.unlink(missing_ok=True)
+    p,q,_,_=run(binary=missing,expect=1,stage='load',old=True)
+    assert q['verdict']['fallback_callback_count']==0
+    damaged=TMP/'damaged.perfbin';damaged.write_bytes(b'not an ELF image')
+    p,q,_,_=run(binary=damaged,expect=1,stage='load',old=True)
+    assert q['verdict']['fallback_callback_count']==0
+    # Existing x86 fixture's foo: executable LOAD off=0, VA=0x400000;
+    # foo VA=0x400540, so the sample file offset is 0x540.
+    p,q,_,_=run(binary=I.parent/'split-dwarf-split.exe',data='17/17 2 cycles: 400540 (/target+0x540)\n',expect=1,stage='generate',old=True)
+    assert 'W_DWO_MISSING' in [w['code'] for w in q['warnings']]
+    for old in [False, True]:
+        p,q,_,_=run(['--debug-binary='+str(HERE/'truncated.debug')],binary=I/'a64-pie.stripped.perfbin',expect=1,stage='generate',old=old)
+        assert 'no usable samples' in p.stderr and 'extends past section size' in p.stderr
+        assert q['samples']['target']['no_cu']['sample_count']==1
+        assert q['samples']['target']['usable']['sample_count']==0
+        assert q['verdict']['fallback_callback_count']==0
+        p,q,_,_=run(binary=HERE/'invalid-symbol.perfbin',expect=1,stage='load',old=old)
+        assert q['verdict']['fallback_callback_count']==1
+        assert p.stderr.count('llvm-profgen: error:')==1
+        p,q,_,_=run(['--debug-binary='+str(HERE/'invalid-symbol.debug')],binary=I/'a64-pie.stripped.perfbin',expect=1,stage='load',old=old)
+        assert q['verdict']['fallback_callback_count']==1
+        for point in ['runtime-open','invalid-image','runtime-metadata','debug-open-load','debug-metadata','context-create','symbolize','debug-open']:
+            stage='generate' if point in ['symbolize','debug-open'] else 'load'
+            p,q,_,_=run(['--debug-binary='+str(I/'a64-pie.debug'),'--ip-test-inject-failure='+point],binary=I/'a64-pie.stripped.perfbin',expect=1,stage=stage,old=old)
+            assert q['verdict']['fallback_callback_count']==1,point
+            assert p.stderr.count('llvm-profgen: error:')==1,(point,p.stderr)
+    p,q,_,_=run(['--allow-missing-build-id=false'],expect=1,stage='identity',old=True)
+    assert 'missing build-id evidence' in p.stderr
+    p,q,_,_=run(['--ip-aggregation=avg'],data='17/17 2 cycles: 1000 (/target+0x1000)\n',binary=I/'boundary-extra/bad-conflict.perfbin',expect=1,stage='boundary',old=True)
+    assert q['boundaries']['failures']
+elif GROUP == 'output':
+    for point in ['profile-write','profile-flush','profile-close','profile-rename']:
+        for old in [False,True]:
+            p,q,_,_=run(['--ip-test-inject-failure='+point],expect=1,old=old,stage='commit' if point=='profile-rename' else 'write')
+            assert q['verdict']['fallback_callback_count']==0
+    for point in ['report-write','report-flush','report-close','report-rename']:
+        p,_,_,_=run(['--ip-test-inject-failure='+point],expect=1,old=True,report_preserved=True)
+        assert 'old report preserved' in p.stderr
+    p,q,_,_=run(['--format=gcc'],expect=1,stage='write',old=True)
+    assert 'profile serialization failed' in p.stderr
+    # A regular file in place of the parent directory works even under root.
+    parent=TMP/'not-directory';parent.write_text('sentinel')
+    p,q,_,_=run(['--output='+str(parent/'profile')],expect=1,stage='write',old=True)
+    assert 'cannot create profile temporary file' in p.stderr
+    p,_,_,_=run(['--quality-report='+str(parent/'report')],expect=1,old=True,report_preserved=True)
+    assert 'cannot create temporary file' in p.stderr
+elif GROUP == 'paths':
+    d=TMP/'aliases';d.mkdir(exist_ok=True)
+    inp=d/'input';inp.write_text(DATA);binary=d/'binary';shutil.copyfile(I/'a64-pie.perfbin',binary)
+    out=d/'out';rep=d/'report';out.write_bytes(OLD);rep.write_bytes(OLD_REPORT)
+    symlink=d/'sym';symlink.unlink(missing_ok=True);symlink.symlink_to(out.name)
+    hard=d/'hard';hard.unlink(missing_ok=True);os.link(out,hard)
+    (d/'real/child').mkdir(parents=True,exist_ok=True)
+    parent_link=d/'parent-link';parent_link.unlink(missing_ok=True)
+    parent_link.symlink_to('real/child',target_is_directory=True)
+    cases=[('-',str(rep),'--output'),(str(out),str(out),'--quality-report'),
+           (str(out),str(symlink),'--quality-report'),(str(out),str(hard),'--quality-report'),
+           (str(inp),str(rep),'--perfscript'),(str(out),str(inp),'--perfscript'),
+           (str(binary),str(rep),'--binary'),(str(out),str(binary),'--binary'),
+           (str(d/'missing'),str(d/'sub/../missing'),'--quality-report'),
+           (str(d/'parent-link/../missing2'),str(d/'real/missing2'),'--quality-report')]
+    for op,rp,check in cases:
+        before={str(f):f.read_bytes() for f in [inp,binary,out,rep]};files=set(d.rglob("*"))
+        cmd=[TOOL,'--ip-samples','--binary='+str(binary),'--perfscript='+str(inp),'--output='+op,'--quality-report='+rp]
+        p=subprocess.run(cmd,capture_output=True,text=True)
+        assert p.returncode and 'path conflict:' in p.stderr and check in p.stderr,p.stderr
+        assert p.stderr.count('llvm-profgen: error:')==1
+        assert before=={f:Path(f).read_bytes() for f in before}
+        assert set(d.rglob("*"))==files
+    for flag in ['quality-report=x','ip-min-usable-ratio=0','ip-min-target-samples=0','ip-max-lost-ratio=0','ip-test-inject-failure=symbolize']:
+        p=subprocess.run([TOOL,'--binary='+str(binary),'--output='+str(out),'--'+flag],capture_output=True,text=True)
+        assert p.returncode and 'IP-only options require --ip-samples' in p.stderr,p.stderr
+elif GROUP == 'writer':
+    p,q,d,_=run(['--use-md5']);assert 'W_MD5_IGNORED' in [w['code'] for w in q['warnings']]
+    p,q,a,_=run(['--format=extbinary','--use-md5'])
+    p,q,b,_=run(['--format=extbinary'])
+    assert (a/'out.prof').read_bytes()!=(b/'out.prof').read_bytes()
+    # Single [ip,ip] LBR range. Its byte-based total is normalized by the
+    # existing LBR update-total-samples option; IP totals remain unchanged.
+    f=I/'boundary-extra/pure-a64.perfbin'
+    p,q,d,_=run(['--ip-zero-fill=sampled-functions','--format=extbinary'],data='17/17 7 cycles: 1000 (/target+0x1000)\n',binary=f)
+    raw=TMP/'lbr.raw';raw.write_text('1\n1000-1000:7\n0\n')
+    lbr=TMP/'lbr.prof'
+    p=subprocess.run([TOOL,'--binary='+str(f),'--unsymbolized-profile='+str(raw),'--use-offset=0','--update-total-samples','--format=extbinary','--output='+str(lbr)],capture_output=True,text=True)
+    assert p.returncode==0,p.stderr
+    assert lbr.read_bytes()==(d/'out.prof').read_bytes(),(str(lbr),str(d/'out.prof'))
+else:
+    raise AssertionError(GROUP)
+print('PASS quality',GROUP)
