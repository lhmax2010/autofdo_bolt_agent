new file mode 100644
index 000000000000..18f5c5ceae3e
--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/boundary-extra/check-boundaries.py
@@ -0,0 +1,174 @@
+#===- check-boundaries.py - IP boundary golden checks ----------------------===#
+# Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+# See https://llvm.org/LICENSE.txt for license information.
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#===----------------------------------------------------------------------===#
+"""No ELF decoding: addresses and profile expectations are hand-derived.
+
+The patch1 JSON, not llvm-profgen or objdump, supplies instruction golden values.
+All generated input/output files are under the lit-provided temporary directory.
+"""
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+TOOL, GROUP, TMP = sys.argv[1:]
+TMP = Path(TMP)
+TMP.mkdir(parents=True, exist_ok=True)
+HERE = Path(__file__).resolve().parent
+INPUTS = HERE.parent
+GOLDEN = json.loads((INPUTS / 'boundary-golden.json').read_text())
+SEQUENCE = 0
+
+
+def run(name, samples, options=(), failure=None, original=False, debug=None):
+    global SEQUENCE
+    SEQUENCE += 1
+    stem = TMP / str(SEQUENCE)
+    stem.with_suffix('.prof').unlink(missing_ok=True)
+    perf = stem.with_suffix('.perfscript')
+    # Boundary fixtures link .text at VA=file offset=0x1000.
+    # The original counting fixtures use VA=file offset+0x1000.
+    perf.write_text(''.join(f'17/17 {period} cycles: {addr:x} (/target+0x{addr-(0x1000 if original else -0x1000 if name=="section-adjacent" else 0):x})\n' for addr, period in samples))
+    binary = (INPUTS if original else HERE) / (name + '.perfbin')
+    cmd = [TOOL, '--ip-samples', '--allow-missing-build-id', '--binary-match-regex=^/target$', '--binary='+str(binary), '--perfscript='+str(perf), '--output='+str(stem.with_suffix('.prof')), '--format=text', '--show-ip-address-counts', '--show-ip-boundaries', *options]
+    if debug:
+        cmd.append('--debug-binary='+str(HERE/debug))
+    p = subprocess.run(cmd, capture_output=True, text=True)
+    stem.with_suffix('.stdout').write_text(p.stdout)
+    stem.with_suffix('.stderr').write_text(p.stderr)
+    if failure:
+        assert p.returncode != 0, (cmd, p.stdout)
+        assert (failure == 'avg denominator multiplication overflow' or 'failure_stage=boundary' in p.stderr) and failure in p.stderr, (cmd, p.stderr)
+        assert not stem.with_suffix('.prof').exists(), cmd
+        return p, ''
+    assert p.returncode == 0, (cmd, p.stdout, p.stderr)
+    return p, stem.with_suffix('.prof').read_text(errors='replace')
+
+
+def starts(p):
+    return [int(v, 16) for v in re.findall(r'^IP-BOUNDARY instruction=(0x[0-9a-f]+)', p.stdout, re.M)]
+
+
+def body(profile):
+    return {m[1]:int(m[2]) for line in profile.splitlines() if (m := re.fullmatch(r' (\d+(?:\.\d+)?): (\d+)',line))}
+
+
+if GROUP == 'positive':
+    for name in ['boundaries','boundary-before_state','boundary-at_state','boundary-discontinuous','boundary-after_data_a32','pure-arm','pure-a64','arm-literal','section-adjacent']:
+        g = GOLDEN[name+'.perfbin']
+        expected = g.get('expected_offsets',g.get('starts'))
+        if 'base' in g:
+            expected = [g['base']+x for x in expected]
+        p, profile = run(name,[(expected[0],10)],['--ip-aggregation=avg'])
+        assert starts(p) == expected, (name, starts(p), expected)
+        assert 'enumerated_functions=1' in p.stdout
+        assert 'boundary_source=' in p.stdout
+        print('PASS golden', name)
+    # Show-boundaries is IP-only, including explicitly false occurrences.
+    p = subprocess.run([TOOL,'--show-ip-boundaries','--binary=x','--output='+str(TMP/'gated')],capture_output=True,text=True)
+    assert p.returncode != 0 and 'IP-only options require --ip-samples' in p.stderr
+elif GROUP == 'negative':
+    for name,addr,why in [('bad-thumb-start',0x1004,'bad-thumb-start'),('bad-thumb-end',0x1000,'bad-thumb-end'),('bad-arm-start',0x101a,'bad-arm-start'),('bad-a64-start',0x1002,'unaligned A64'),('bad-a64-end',0x1000,'truncated A64'),('bad-conflict',0x1000,'conflicting mapping states'),('bad-no-map',0x1000,'no usable mapping symbols')]:
+        run(name,[(addr,10)],['--ip-aggregation=avg'],failure=why)
+        print('PASS negative',name)
+    for name in ['bad-no-map','a64-no-map']:
+        for opts in [['--ip-aggregation=avg'],['--ip-aggregation=sum','--ip-zero-fill=sampled-functions'],['--ip-aggregation=max','--ip-skid=prev-inst']]:
+            run(name,[(0x1000,10)],opts,failure='no usable mapping symbols')
+        for aggregation in ['sum','max']:
+            p,_=run(name,[(0x1000,10)],['--ip-aggregation='+aggregation])
+            assert 'enumerated_functions=0' in p.stdout and not starts(p)
+    for address in [0x1001,0x1004,0x100e]:
+        # Odd PC is not cleared; middle of MOV.W and decodable data both fail.
+        run('boundaries',[(address,10)],['--ip-aggregation=avg'],failure='sample is not an instruction start')
+    print('PASS no-map gating and invalid sampled PC')
+elif GROUP == 'zero':
+    p,plain=run('boundaries',[(0x1006,50)],['--ip-aggregation=sum','--ip-period-unit=1'])
+    p,zero=run('boundaries',[(0x1006,50)],['--ip-aggregation=sum','--ip-period-unit=1','--ip-zero-fill=sampled-functions','--ip-head-samples=entry-estimate'])
+    expected={str(n):0 for n in [0,2,6,8,10,18,24,28,32,34]};expected['6']=50
+    assert body(plain)=={'6':50} and body(zero)==expected, (plain,zero)
+    assert plain.splitlines()[0]=='whole_mixed:50:0'
+    assert zero.splitlines()[0]=='whole_mixed:50:1',zero
+    print('PASS zero keys, stable total and head fallback 1')
+elif GROUP == 'skid':
+    # Original->previous: 2->0 (16bit), 6->2 (32bit), 8->6 (IT).
+    # Range first, after inline tables, and cross-range cannot move.
+    for name,addr,previous,unadjusted in [('boundaries',0x1002,0x1000,0),('boundaries',0x1006,0x1002,0),('boundaries',0x1008,0x1006,0),('boundaries',0x1000,0x1000,1),('boundaries',0x1012,0x1012,1),('boundaries',0x1018,0x1018,1),('boundary-before_state',0x1002,0x1002,1),('boundary-discontinuous',0x1022,0x1022,1),('section-adjacent',0x1004,0x1004,1)]:
+        p,prof=run(name,[(addr,7)],['--ip-aggregation=sum','--ip-skid=prev-inst'])
+        anchor=0x1004 if name=='section-adjacent' else 0x1000
+        assert body(prof)=={str(previous-anchor):1},(name,addr,prof)
+        assert f'skid_unadjusted samples={unadjusted} period_sum={7*unadjusted}' in p.stdout,p.stdout
+        assert 'p_ref=7 source=automatic' in p.stdout
+    # main's predecessor in layout belongs to two_sites, not main.
+    p,prof=run('a64-pie',[(0x13f4,7)],['--ip-aggregation=sum','--ip-skid=prev-inst'],original=True)
+    assert 'skid_unadjusted samples=1 period_sum=7' in p.stdout
+    assert prof=='main:1:0\n 0: 1\n',prof
+    for name,addr,reason in [('boundaries',0x1020,'data_or_state_change'),
+                             ('skid-no-line',0x1002,'predecessor_no_line')]:
+        p,prof=run(name,[(addr,7)],['--ip-aggregation=sum','--ip-skid=prev-inst'])
+        assert body(prof)=={str(addr-0x1000):1},prof
+        assert f'skid_unadjusted_{reason} samples=1 period_sum=7' in p.stdout,p.stdout
+        assert 'IP-GENERATION usable samples=1 period_sum=7' in p.stdout
+        assert 'IP-GENERATION in_func_no_line samples=0 period_sum=0' in p.stdout
+        counts=re.findall(r'^IP-GENERATION skid_unadjusted_(?:first_instruction|range_gap|data_or_state_change|predecessor_no_line) samples=(\d+) period_sum=(\d+)$',p.stdout,re.M)
+        assert len(counts)==4 and sum(int(x[0]) for x in counts)==1 and sum(int(x[1]) for x in counts)==7,counts
+    p,prof=run('skid-no-line',[(0x1000,7),(0x1002,7)],['--ip-aggregation=sum','--ip-skid=prev-inst'])
+    assert 'IP-GENERATION usable samples=1 period_sum=7' in p.stdout
+    assert 'IP-GENERATION in_func_no_line samples=1 period_sum=7' in p.stdout
+    print('PASS skid predecessors, range/data/function barriers and original period')
+elif GROUP == 'avg-manual':
+    # Two instructions share one key. Only one is sampled: numerator=10,
+    # n(k)=2 (includes unsampled instruction), P_ref=1 => body=5, total=10.
+    for name,addr in [('arm-uniform',0x1000),('discontinuous-uniform',0x1002)]:
+        p,prof=run(name,[(addr,10)],['--ip-aggregation=avg','--ip-period-unit=1'])
+        assert body(prof)=={'0':5},prof
+        assert prof.splitlines()[0].split(':')[-2:] == ['10','0'],prof
+    run('arm-uniform',[(0x1000,1)],['--ip-aggregation=avg','--ip-period-unit=18446744073709551615'],failure='avg denominator multiplication overflow')
+    print('PASS avg unsampled and discontiguous denominators')
+elif GROUP == 'avg-counting':
+    # GNU addr2line + objdump independently identify 15 instructions with
+    # raw discriminator 1028 => base2, duplication4, line12-decl9=3.
+    # Seven unsampled instructions are part of n(k): round(32*4/15)=9.
+    addresses = {
+        'a64-pie':[0x1318,0x131c,0x1324,0x1328,0x1330,0x1334,0x133c,0x1340],
+        'arm-count':[0x12c8,0x12d0,0x12d8,0x12dc,0x12e0,0x12e4,0x12e8,0x12ec],
+        'thumb-count':[0x12be,0x12c4,0x12ca,0x12ce,0x12d2,0x12d4,0x12da,0x12de],
+        'thumb-no-attributes':[0x12be,0x12c4,0x12ca,0x12ce,0x12d2,0x12d4,0x12da,0x12de],
+    }
+    for name, aa in addresses.items():
+        sample=list(zip(aa,[2,6]*4))
+        for aggregation, expected in [('sum',32),('max',24),('avg',9)]:
+            p,prof=run(name,sample,['--ip-aggregation='+aggregation,'--ip-period-unit=1'],original=True)
+            assert prof=='count_loop:32:0\n 3.2: '+str(expected)+'\n', (name,aggregation,prof)
+            assert ('enumerated_functions=1' in p.stdout)==(aggregation=='avg')
+        # Same total after filling missing keys; other top-level functions
+        # (main and two_sites) must not appear.
+        _,prof=run(name,sample,['--ip-aggregation=avg','--ip-period-unit=1','--ip-zero-fill=sampled-functions'],original=True)
+        assert prof.splitlines()[0]=='count_loop:32:0' and body(prof)['3.2']==9
+        assert len([l for l in prof.splitlines() if l and not l.startswith(' ')])==1
+        assert any(v==0 for v in body(prof).values()),prof
+        # Positive numerator smaller than denominator is kept at one.
+        _,prof=run(name,[(aa[0],1)],['--ip-aggregation=avg','--ip-period-unit=1'],original=True)
+        assert prof=='count_loop:1:0\n 3.2: 1\n',prof
+    print('PASS avg unrolling, unsampled copies, min1 and zero-fill scope')
+elif GROUP == 'split':
+    opts=['--ip-aggregation=avg','--ip-period-unit=1','--ip-zero-fill=sampled-functions','--ip-skid=prev-inst']
+    samples=[(0x1006,10),(0x1012,20)]
+    p,plain=run('boundaries',samples,opts)
+    q,split=run('boundaries.stripped',samples,opts,debug='boundaries.debug')
+    assert plain==split
+    assert starts(p)==starts(q)
+    assert 'boundaries.debug' in q.stdout
+    for fmt in ['text','binary','extbinary']:
+        options=opts+['--format='+fmt]
+        p,_=run('boundaries',samples,options)
+        first=(TMP/(str(SEQUENCE)+'.prof')).read_bytes()
+        q,_=run('boundaries',samples,options)
+        second=(TMP/(str(SEQUENCE)+'.prof')).read_bytes()
+        assert first==second and p.stdout==q.stdout and p.stderr==q.stderr,(fmt,p.stderr,q.stderr)
+    print('PASS split debug and deterministic three formats')
+else:
+    raise ValueError(GROUP)
+print('PASS group',GROUP)
