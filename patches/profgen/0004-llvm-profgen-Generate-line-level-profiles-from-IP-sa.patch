+     << " weight=" << (Options.SampleWeight ? "sample" : "period")
+     << " aggregation=" << (Options.MaxAggregation ? "max" : "sum")
+     << " fs_discriminator=" << (FSDiscriminator ? "true" : "false") << '\n';
+  for (const auto &[Name, C] : Counts)
+    OS << "IP-GENERATION " << Name << " samples=" << C.SampleCount
+       << " period_sum=" << C.PeriodSum << '\n';
+}
+
+Error ProfileGenerator::populateBodySamplesFromAddresses(
+    const AddressCounter &Counts, const IPGenerationOptions &Options,
+    IPGenerationStatistics &Statistics) {
+  UseFSDiscriminator = Binary->useFSDiscriminator();
+  FunctionSamples::ProfileIsFS = UseFSDiscriminator;
+  FunctionSamples::ProfileIsCS = false;
+  FunctionSamples::ProfileIsProbeBased = false;
+  for (StringRef Name :
+       {"usable", "in_func_no_line", "outside_dwarf_func", "plt",
+        "in_cu_no_subprogram", "no_cu", "usable_nonleaf_line_zero"})
+    Statistics.Counts[Name.str()] = {};
+  auto Classify = [&](StringRef Name, const IPAddressCount &C) -> Error {
+    auto &Sum = Statistics.Counts[Name.str()];
+    if (Error E = addIPCount(Sum.SampleCount, C.SampleCount))
+      return E;
+    return addIPCount(Sum.PeriodSum, C.PeriodSum);
+  };
+  // FunctionSamples nodes identify the entire inline callsite chain. Both
+  // totals and body numerators remain exact integers until final
+  // materialization.
+  std::map<FunctionSamples *, uint64_t> Totals;
+  std::map<FunctionSamples *, std::map<LineLocation, uint64_t>> Bodies;
+  for (const auto &[Address, C] : Counts) {
+    if (!Binary->findFuncRange(Address)) {
+      if (Error E = Classify("outside_dwarf_func", C))
+        return E;
+      if (Error E = Classify(Binary->classifyOutsideIP(Address), C))
+        return E;
+      continue;
+    }
+    const auto &Frames = Binary->getCachedFrameLocationStack(Address);
+    if (Frames.empty()) {
+      if (Error E = Classify("in_func_no_line", C))
+        return E;
+      continue;
+    }
+    if (Error E = Classify("usable", C))
+      return E;
+    if (Binary->hasIPNonLeafZeroLine(Address))
+      if (Error E = Classify("usable_nonleaf_line_zero", C))
+        return E;
+    uint64_t Numerator = Options.SampleWeight ? C.SampleCount : C.PeriodSum;
+    SampleContextFrameVector Prefix;
+    FunctionSamples *Leaf = nullptr;
+    for (const auto &Frame : Frames) {
+      Prefix.push_back(Frame);
+      // Reuse only tree construction, adding no rounded samples here.
+      Leaf = &getLeafProfileAndAddTotalSamples(Prefix, 0);
+      if (Error E = addIPCount(Totals[Leaf], Numerator))
+        return E;
+    }
+    const auto &Location = Frames.back().Location;
+    LineLocation Key(Location.LineOffset,
+                     getBaseDiscriminator(Location.Discriminator));
+    auto &Body = Bodies[Leaf][Key];
+    if (Options.MaxAggregation) {
+      auto Product = checkedMulUnsigned(
+          Numerator, uint64_t(getDuplicationFactor(Location.Discriminator)));
+      if (!Product)
+        return ipGenerationError("duplication multiplication overflow");
+      Body = std::max(Body, *Product);
+    } else if (Error E = addIPCount(Body, Numerator)) {
+      return E;
+    }
+  }
+  if (!Statistics.Counts["usable"].SampleCount)
+    return ipGenerationError("no usable samples");
+  bool LargeCount = false;
+  for (auto [FS, Numerator] : Totals) {
+    uint64_t Count = roundIPCount(Numerator, Options.PeriodUnit);
+    FS->setTotalSamples(Count);
+    LargeCount |= Count > UINT32_MAX;
+  }
+  uint64_t AllBodyCounts = 0;
+  for (auto &[FS, Locations] : Bodies)
+    for (auto [Location, Numerator] : Locations) {
+      uint64_t Count = roundIPCount(Numerator, Options.PeriodUnit);
+      // Also guard the existing summary/density accumulation of body counts.
+      if (Error E = addIPCount(AllBodyCounts, Count))
+        return E;
+      FS->addBodySamples(Location.LineOffset, Location.Discriminator, Count);
+      LargeCount |= Count > UINT32_MAX;
+    }
+  if (!AllBodyCounts)
+    return ipGenerationError("no positive profile locations");
+  if (LargeCount)
+    WithColor::warning() << "IP body or total exceeds UINT32_MAX\n";
+  if (Options.EstimateHead)
+    for (auto &Entry : ProfileMap) {
+      auto Checked = checkIPHead(Entry.second);
+      if (!Checked)
+        return Checked.takeError();
+      Entry.second.setHeadSamples(Entry.second.getHeadSamplesEstimate());
+    }
+  postProcessProfiles();
+  if (ProfileMap.empty())
+    return ipGenerationError("no writable profile after post-processing");
+  auto HasPositiveBody = [](auto &Self, const FunctionSamples &FS) -> bool {
+    for (const auto &Body : FS.getBodySamples())
+      if (Body.second.getSamples())
+        return true;
+    for (const auto &Call : FS.getCallsiteSamples())
+      for (const auto &Callee : Call.second)
+        if (Self(Self, Callee.second))
+          return true;
+    return false;
+  };
+  if (!llvm::any_of(ProfileMap, [&](const auto &Entry) {
+        return HasPositiveBody(HasPositiveBody, Entry.second);
+      }))
+    return ipGenerationError(
+        "no positive profile locations after post-processing");
+  return Error::success();
+}
+
+Error ProfileGenerator::writeIPProfile() {
+  SmallString<256> TemporaryPath;
+  int FD;
+  auto Flags = OutputFormat == SPF_Binary || OutputFormat == SPF_Ext_Binary
+                   ? sys::fs::OF_None
+                   : sys::fs::OF_TextWithCRLF;
+  if (std::error_code EC = sys::fs::createUniqueFile(
+          OutputFilename + ".tmp-%%%%%%", FD, TemporaryPath, Flags))
+    return createStringError(
+        EC, "IP sample mode: cannot create profile temporary file");
+  scope_exit Cleanup([&] { sys::fs::remove(TemporaryPath); });
+  std::unique_ptr<raw_ostream> Stream =
+      std::make_unique<raw_fd_ostream>(FD, true);
+  auto *FileStream = static_cast<raw_fd_ostream *>(Stream.get());
+  // The stream overload allows explicit close/error handling before commit;
+  // the filename overload would hide the stream's final I/O status.
+  auto Writer = SampleProfileWriter::create(Stream, OutputFormat);
+  std::error_code WriteError;
+  if (!Writer) {
+    WriteError = Writer.getError();
+  } else {
+    if (UseMD5) {
+      if (OutputFormat != SPF_Ext_Binary)
+        WithColor::warning() << "-use-md5 is ignored. Specify "
+                                "--format=extbinary to enable it\n";
+      else
+        (*Writer)->setUseMD5();
+    }
+    WriteError = (*Writer)->write(ProfileMap);
+  }
+  FileStream->flush();
+  FileStream->close();
+  std::error_code CloseError = FileStream->error();
+  if (FileStream->has_error())
+    FileStream->clear_error();
+  // No error may be deferred to raw_fd_ostream's destructor.
+  if (WriteError)
+    return createStringError(WriteError,
+                             "IP sample mode: profile serialization failed");
+  if (CloseError)
+    return createStringError(CloseError,
+                             "IP sample mode: profile flush/close failed");
+  if (std::error_code EC = sys::fs::rename(TemporaryPath, OutputFilename))
+    return createStringError(EC, "IP sample mode: profile commit failed");
+  return Error::success();
+}
