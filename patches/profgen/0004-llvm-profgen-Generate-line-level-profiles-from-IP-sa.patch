+  // Include all target-DSO samples before symbolization, even segment misses.
+  std::vector<uint64_t> Periods;
+  for (const Sample *S : SelectedSamples)
+    Periods.push_back(S->Period);
+  assert(!Periods.empty() && "reader rejects an empty target");
+  auto Middle = Periods.begin() + (Periods.size() - 1) / 2;
+  std::nth_element(Periods.begin(), Middle, Periods.end());
+  return *Middle;
+}
