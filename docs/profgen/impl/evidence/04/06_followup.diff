+# RUN: not llvm-profgen --ip-samples --binary=x --pid=-1 --output=%t.out 2>&1 | FileCheck %s --check-prefix=PID
+# RUN: not llvm-profgen --pid=-2 --binary=x --output=%t.out --ip-samples 2>&1 | FileCheck %s --check-prefix=PID
