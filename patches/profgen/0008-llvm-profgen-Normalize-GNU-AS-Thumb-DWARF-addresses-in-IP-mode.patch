+bool IPBoundaryMap::isThumbAddress(uint64_t Address) const {
+  const Section *Match = nullptr;
+  for (const auto &S : Sections)
+    if (Address >= S.Begin && Address < S.End) {
+      if (Match)
+        return false;
+      Match = &S;
+    }
+  if (!Match)
+    return false;
+  auto It = Match->States.upper_bound(Address);
+  if (It == Match->States.begin())
+    return false;
+  --It;
+  return It->second == 't' && !Match->Conflicts.count(It->first);
+}
