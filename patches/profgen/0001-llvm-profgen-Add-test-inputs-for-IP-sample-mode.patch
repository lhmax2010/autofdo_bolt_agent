+.syntax unified
+.section .text,"ax",%progbits
+.balign 4
+.local $t.1
+.type $t.1,%notype
+$t.1:
+.globl anchor
+anchor:
+.byte 0x00,0xbf                       // 0: 16-bit NOP (prefix outside before_state)
+.byte 0x4f,0xf0,0x01,0x00             // 2: 32-bit MOV.W r0,#1
+.byte 0x08,0xbf                       // 6: IT EQ
+.byte 0x01,0x20                       // 8: 16-bit MOVS r0,#1 (inside IT)
+.byte 0xdf,0xe8,0x00,0xf0             // 10: TBB [pc,r0]
+.local $d.literal
+.type $d.literal,%notype
+$d.literal:
+.byte 0x00,0xbf,0x00,0xbf             // 14: table/data also valid NOP encodings
+.local $t.hot
+.type $t.hot,%notype
+$t.hot:
+.byte 0xdf,0xe8,0x10,0xf0             // 18: TBH [pc,r0,lsl #1]
+.local $d.table
+.type $d.table,%notype
+$d.table:
+.byte 0x00,0xbf                       // 22: halfword table
+.local $a.arm
+.type $a.arm,%notype
+$a.arm:
+.byte 0x00,0x00,0xa0,0xe1             // 24: A32 MOV r0,r0
+.byte 0x1e,0xff,0x2f,0xe1             // 28: A32 BX lr
+.local $t.tail
+.type $t.tail,%notype
+$t.tail:
+.byte 0x00,0xbf,0x70,0x47             // 32,34: Thumb NOP; BX lr
+.globl anchor_end
+anchor_end:
+
+.section .debug_abbrev,"",%progbits
+.byte 1,0x11,1, 0x03,0x08, 0x11,0x01, 0x12,0x06, 0,0
+.byte 2,0x2e,0, 0x03,0x08, 0x55,0x17, 0,0
+.byte 0
+.section .debug_info,"",%progbits
+.long .Lcu_end-.Lcu_start
+.Lcu_start:
+.short 4
+.long 0
+.byte 4
+.byte 1
+.asciz "manual-boundaries.s"
+.long 0
+.long 0x100000
+.byte 2
+.asciz "before_state"
+.long .Lranges0-.Lranges_start
+.byte 0
+.Lcu_end:
+.section .debug_ranges,"",%progbits
+.Lranges_start:
