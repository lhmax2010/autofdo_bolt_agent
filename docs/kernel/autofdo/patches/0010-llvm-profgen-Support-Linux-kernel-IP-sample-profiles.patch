+Expected<StringRef> IPBoundaryMap::kernelExclusion(uint64_t Address) const {
+  const Section *Match = nullptr;
+  bool Special = false;
+  for (const Section &S : Sections) {
+    if (Address < S.Begin || Address >= S.End)
+      continue;
+    StringRef Name = S.Name;
+    if (Name == ".head.text" || Name == ".stubs" || Name == ".plt" ||
+        Name == ".iplt" || Name.starts_with(".plt.") ||
+        Name.starts_with(".vectors") || Name.starts_with(".init.") ||
+        Name.starts_with(".exit.")) {
+      Special = true;
+      continue;
+    }
+    if (Match)
+      return boundaryError("ambiguous executable section for kernel IP");
+    Match = &S;
+  }
+  if (!Match)
+    return StringRef("kernel_special_section");
+  if (Special)
+    return boundaryError("ambiguous executable section for kernel IP");
+  auto It = Match->States.upper_bound(Address);
+  if (It == Match->States.begin())
+    return StringRef();
+  --It;
+  if (Match->Conflicts.count(It->first))
+    return boundaryError("conflicting mapping states for kernel IP");
+  return It->second == 'd' ? StringRef("kernel_mapping_data") : StringRef();
+}
