+      NO_SUB_SUPER_W(29)
+      NO_SUB_SUPER_W(30)
+      NO_SUB_SUPER_W(31)
+    }
+  case 32:
+    switch (Reg.id()) {
+      DEFAULT_NOREG
+      A_SUB_SUPER(EAX)
+      D_SUB_SUPER(EDX)
+      C_SUB_SUPER(ECX)
+      B_SUB_SUPER(EBX)
+      SI_SUB_SUPER(ESI)
+      DI_SUB_SUPER(EDI)
+      BP_SUB_SUPER(EBP)
+      SP_SUB_SUPER(ESP)
+      NO_SUB_SUPER_D(8)
+      NO_SUB_SUPER_D(9)
+      NO_SUB_SUPER_D(10)
+      NO_SUB_SUPER_D(11)
+      NO_SUB_SUPER_D(12)
