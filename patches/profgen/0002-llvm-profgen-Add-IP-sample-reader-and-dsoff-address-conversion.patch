diff --git a/llvm/tools/llvm-profgen/IPPerfReader.cpp b/llvm/tools/llvm-profgen/IPPerfReader.cpp
new file mode 100644
index 000000000000..c9fc0f738a7d
--- /dev/null
+++ b/llvm/tools/llvm-profgen/IPPerfReader.cpp
@@ -0,0 +1,392 @@
+//===- IPPerfReader.cpp - IP-only perf script reader
+//------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#include "IPPerfReader.h"
+#include "llvm/ADT/SmallString.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/Object/ELFObjectFile.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/Format.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/Regex.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <limits>
+
+using namespace llvm;
+using namespace llvm::object;
+
+namespace {
+Error invalid(StringRef What) {
+  return createStringError(inconvertibleErrorCode(), "IP sample mode: " + What);
+}
+Error add(uint64_t &Value, uint64_t Increment) {
+  if (Increment > std::numeric_limits<uint64_t>::max() - Value)
+    return invalid("counter overflow");
+  Value += Increment;
+  return Error::success();
+}
+
+/// Unlike getAsInteger alone, reject signs, prefixes and non-digit suffixes.
+bool number(StringRef Text, uint64_t &Value, unsigned Base,
+            bool AllowPrefix = false) {
+  if (AllowPrefix)
+    Text.consume_front("0x");
+  if (Text.empty() || !llvm::all_of(Text, [Base](char C) {
+        return Base == 16 ? isHexDigit(C) : isDigit(C);
+      }))
+    return false;
+  return !Text.getAsInteger(Base, Value);
+}
+
+bool id(StringRef Text, int64_t &Value) {
+  if (Text == "-1") {
+    Value = -1;
+    return true;
+  }
+  uint64_t U;
+  if (!number(Text, U, 10) || U > uint64_t(INT64_MAX))
+    return false;
+  Value = U;
+  return true;
+}
+
+StringRef word(StringRef &Text) {
+  Text = Text.ltrim(" \t");
+  size_t End = Text.find_first_of(" \t");
+  StringRef Result = Text.take_front(End);
+  Text = End == StringRef::npos ? StringRef() : Text.drop_front(End);
+  return Result;
+}
+
+bool ids(StringRef &Text, int64_t &PID, int64_t &TID, bool Inner = false) {
+  StringRef Pair = word(Text);
+  if (Inner && !Pair.consume_back(":"))
+    return false;
+  auto [P, T] = Pair.split('/');
+  return id(P, PID) && id(T, TID);
+}
+
+bool deleted(StringRef Path) { return Path.ends_with(" (deleted)"); }
+StringRef livePath(StringRef Path) {
+  Path.consume_back(" (deleted)");
+  return Path;
+}
+bool kernel(StringRef Path) {
+  Path = livePath(Path);
+  return Path == "[kernel.kallsyms]" ||
+         (Path.starts_with("/lib/modules/") &&
+          (Path.ends_with(".ko") || Path.ends_with(".ko.xz") ||
+           Path.ends_with(".ko.zst") || Path.ends_with(".ko.gz")));
+}
+bool special(StringRef Path) {
+  // perf pseudo DSOs and JIT map names are not sampled object-file paths.
+  return Path.starts_with("[") || Path.starts_with("//") ||
+         (Path.starts_with("/tmp/perf-") && Path.ends_with(".map")) ||
+         (Path.starts_with("jitted-") && Path.ends_with(".so"));
+}
+} // namespace
+
+Error IPPerfReader::parseLine(StringRef Line) {
+  if (Line.contains('\0'))
+    return invalid("unrepresentable input line");
+  StringRef Rest = Line;
+  int64_t PID, TID;
+  if (!ids(Rest, PID, TID))
+    return invalid("invalid pid/tid");
+  StringRef Kind = word(Rest);
+  if (Kind == "PERF_RECORD_LOST") {
+    uint64_t N;
+    if (word(Rest) != "lost" || !number(word(Rest), N, 10) ||
+        !Rest.trim().empty())
+      return invalid("invalid LOST record");
+    if (Error E = add(Stats.LostRecords, 1))
+      return E;
+    return add(Stats.LostCount, N);
+  }
+  if (Kind == "PERF_RECORD_MMAP" || Kind == "PERF_RECORD_MMAP2") {
+    IPMapping M;
+    M.Raw = Line.str();
+    M.IsMmap2 = Kind == "PERF_RECORD_MMAP2";
+    if (!ids(Rest, M.PID, M.TID, true))
+      return invalid("invalid mapping pid/tid");
+    Rest = Rest.ltrim(" \t");
+    if (!Rest.consume_front("["))
+      return invalid("invalid mapping range");
+    auto [Start, Tail] = Rest.split('(');
+    Rest = Tail;
+    auto [Length, AfterLength] = Rest.split(')');
+    Rest = AfterLength;
+    if (!number(Start, M.Start, 16, true) ||
+        !number(Length, M.Length, 16, true) || !Rest.consume_front(" @ "))
+      return invalid("invalid mapping range");
+    size_t End = Rest.find("]: ");
+    if (End == StringRef::npos)
+      return invalid("truncated mapping record");
+    StringRef Identity = Rest.take_front(End);
+    Rest = Rest.drop_front(End + 3);
+    if (!number(word(Identity), M.PageOffset, 16, true))
+      return invalid("invalid mapping pgoff");
+    Identity = Identity.trim();
+    if (M.IsMmap2) {
+      if (Identity.starts_with("<")) {
+        if (!Identity.consume_front("<") || !Identity.consume_back(">") ||
+            Identity.empty() || Identity.size() % 2 ||
+            !llvm::all_of(Identity, isHexDigit))
+          return invalid("invalid mapping build-id");
+        M.BuildID = Identity.str();
+      } else {
+        StringRef Device = word(Identity), Inode = word(Identity);
+        StringRef Generation = word(Identity);
+        auto [Major, Minor] = Device.split(':');
+        uint64_t V;
+        if (!number(Major, V, 16) || !number(Minor, V, 16) ||
+            !number(Inode, V, 10) || !number(Generation, V, 10) ||
+            !Identity.trim().empty())
+          return invalid("invalid mapping inode identity");
+        M.Device = Device.str();
+        M.Inode = Inode.str();
+        M.Generation = Generation.str();
+      }
+    } else if (!Identity.empty()) {
+      return invalid("unexpected MMAP identity");
+    }
+    StringRef Permissions = word(Rest);
+    bool ValidPermissions =
+        M.IsMmap2 ? Permissions.size() == 4 &&
+                        (Permissions[0] == 'r' || Permissions[0] == '-') &&
+                        (Permissions[1] == 'w' || Permissions[1] == '-') &&
+                        (Permissions[2] == 'x' || Permissions[2] == '-') &&
+                        (Permissions[3] == 'p' || Permissions[3] == 's')
+                  : Permissions == "x" || Permissions == "r";
+    if (!ValidPermissions || !Rest.consume_front(" ") || Rest.empty())
+      return invalid("invalid mapping permissions or path");
+    uint64_t RangeEnd = M.Start, OffsetEnd = M.PageOffset;
+    if (Error E = add(RangeEnd, M.Length))
+      return E;
+    if (Error E = add(OffsetEnd, M.Length))
+      return E;
+    M.Permissions = Permissions.str();
+    M.Path = Rest.str();
+    M.Deleted = deleted(Rest);
+    Mappings.push_back(std::move(M));
+    return Error::success();
+  }
+  if (Kind.starts_with("PERF_RECORD_"))
+    return invalid("unrecognized record type");
+
+  Sample S;
+  S.PID = PID;
+  S.TID = TID;
+  if (!number(Kind, S.Period, 10) || !S.Period)
+    return invalid("invalid or zero period");
+  StringRef Event = word(Rest);
+  if (!Event.consume_back(":") || Event.empty())
+    return invalid("missing event name");
+  S.Event = Event.str();
+  if (!number(word(Rest), S.IP, 16))
+    return invalid("invalid instruction pointer");
+  // Consume the fixed prefix FIRST. Parentheses inside a DSO are path bytes,
+  // not delimiters: never split on the last " (" in a sample line.
+  Rest = Rest.ltrim(" \t");
+  if (!Rest.consume_front("(") || !Rest.consume_back(")") || Rest.empty())
+    return invalid("invalid DSO field (expected dsoff, no branch/call stack)");
+  size_t Plus = Rest.rfind("+0x");
+  if (Plus != StringRef::npos) {
+    uint64_t Offset;
+    if (number(Rest.drop_front(Plus + 3), Offset, 16)) {
+      S.Offset = Offset;
+      Rest = Rest.take_front(Plus);
+    } else {
+      return invalid("invalid dsoff offset");
+    }
+  }
+  if (Rest.empty())
+    return invalid("empty DSO path");
+  S.Path = Rest.str();
+  S.Deleted = deleted(Rest);
+  if (!S.Offset && !special(Rest) && Rest != "[kernel.kallsyms]")
+    return invalid("file DSO is missing dsoff");
+  if (Error E = add(Stats.Input, 1))
+    return E;
+  if (Error E = add(Stats.Events[S.Event], 1))
+    return E;
+  if (PID == -1)
+    if (Error E = add(Stats.PIDUnknown, 1))
+      return E;
+  Samples.push_back(std::move(S));
+  return Error::success();
+}
+
+Error IPPerfReader::loadBinary(StringRef Path) {
+  BinaryPath = Path.str();
+  SmallString<256> Real;
+  if (std::error_code EC = sys::fs::real_path(Path, Real))
+    return createStringError(EC, "IP sample mode: cannot resolve binary");
+  BinaryRealPath = Real.str().str();
+  auto Object = ObjectFile::createObjectFile(Path);
+  if (!Object)
+    return Object.takeError();
+  auto Load = [&](const auto *ELFObject) -> Error {
+    auto Headers = ELFObject->getELFFile().program_headers();
+    if (!Headers)
+      return Headers.takeError();
+    for (const auto &H : *Headers) {
+      if (H.p_type != ELF::PT_LOAD || !(H.p_flags & ELF::PF_X))
+        continue;
+      uint64_t End = H.p_offset, VEnd = H.p_vaddr;
+      if (Error E = add(End, H.p_filesz))
+        return E;
+      if (Error E = add(VEnd, H.p_filesz))
+        return E;
+      Segments.push_back({H.p_offset, End, H.p_vaddr});
+    }
+    return Error::success();
+  };
+  const ObjectFile *O = Object->getBinary();
+  if (const auto *E = dyn_cast<ELF32LEObjectFile>(O))
+    return Load(E);
+  if (const auto *E = dyn_cast<ELF64LEObjectFile>(O))
+    return Load(E);
+  if (const auto *E = dyn_cast<ELF32BEObjectFile>(O))
+    return Load(E);
+  if (const auto *E = dyn_cast<ELF64BEObjectFile>(O))
+    return Load(E);
+  return invalid("binary must be an ELF object");
+}
+
+Error IPPerfReader::selectSamples(const IPReaderOptions &Options) {
+  if (!Options.Event && Stats.Events.size() > 1)
+    return invalid("multiple events require --ip-event");
+  std::optional<Regex> Match;
+  if (Options.BinaryMatchRegex) {
+    Match.emplace(*Options.BinaryMatchRegex);
+    std::string Why;
+    if (!Match->isValid(Why))
+      return invalid("invalid --binary-match-regex: " + Why);
+  }
+  std::map<std::string, uint64_t> Files;
+  for (const Sample &S : Samples) {
+    if (Options.Event && S.Event != *Options.Event)
+      continue;
+    if (Error E = add(Stats.AfterEvent, 1))
+      return E;
+    if (Options.PID && (S.PID == -1 || uint64_t(S.PID) != *Options.PID))
+      continue;
+    if (Error E = add(Stats.AfterPID, 1))
+      return E;
+    if (kernel(S.Path)) {
+      if (Error E = add(Stats.Kernel, 1))
+        return E;
+      continue;
+    }
+    if (special(S.Path)) {
+      if (Error E = add(S.Offset ? Stats.OtherDSO : Stats.Unmapped, 1))
+        return E;
+      continue;
+    }
+    if (Error E = add(Files[S.Path], 1))
+      return E;
+    bool Selected = Match ? Match->match(S.Path)
+                          : sys::path::filename(livePath(S.Path)) ==
+                                sys::path::filename(BinaryRealPath);
+    if (!Selected) {
+      if (Error E = add(Stats.OtherDSO, 1))
+        return E;
+      continue;
+    }
+    if (Error E = add(Stats.Target, 1))
+      return E;
+    const Segment *Found = nullptr;
+    for (const Segment &Seg : Segments) {
+      if (*S.Offset < Seg.Offset || *S.Offset >= Seg.End)
+        continue;
+      if (Found)
+        return invalid("dsoff matches multiple executable PT_LOAD segments");
+      Found = &Seg;
+    }
+    if (!Found) {
+      if (Error E = add(Stats.UnmappedInTarget, 1))
+        return E;
+      continue;
+    }
+    uint64_t VA = Found->VAddr;
+    if (Error E = add(VA, *S.Offset - Found->Offset))
+      return E;
+    auto &C = Counts[VA];
+    if (Error E = add(C.SampleCount, 1))
+      return E;
+    if (Error E = add(C.PeriodSum, S.Period))
+      return E;
+  }
+  if (Options.Event && !Stats.AfterEvent)
+    return invalid("event filter selected no samples");
+  if (!Stats.Target) {
+    std::vector<std::pair<std::string, uint64_t>> Top(Files.begin(),
+                                                      Files.end());
+    llvm::sort(Top, [](const auto &A, const auto &B) {
+      return A.second != B.second ? A.second > B.second : A.first < B.first;
+    });
+    std::string Message =
+        "no target samples; use --binary-match-regex; top file DSOs:";
+    for (size_t I = 0; I < std::min<size_t>(5, Top.size()); ++I)
+      Message += "\n  " + Top[I].first + " " + std::to_string(Top[I].second);
+    return invalid(Message);
+  }
+  return Error::success();
+}
+
+Error IPPerfReader::read(StringRef Trace, StringRef Binary,
+                         const IPReaderOptions &Options) {
+  auto Buffer = MemoryBuffer::getFile(Trace);
+  if (!Buffer)
+    return createStringError(Buffer.getError(),
+                             "IP sample mode: cannot read input");
+  StringRef Text = (*Buffer)->getBuffer();
+  unsigned LineNumber = 0;
+  while (!Text.empty()) {
+    auto [Line, Tail] = Text.split('\n');
+    Text = Tail;
+    ++LineNumber;
+    if (Error E = parseLine(Line))
+      return invalid("line " + Twine(LineNumber).str() + ": " +
+                     toString(std::move(E)));
+  }
+  if (Error E = loadBinary(Binary))
+    return E;
+  return selectSamples(Options);
+}
+
+void IPPerfReader::printAddressCounts(raw_ostream &OS) const {
+  for (const auto &[Address, Count] : Counts)
+    OS << "IP-ADDRESS " << format_hex(Address, 1)
+       << " sample_count=" << Count.SampleCount
+       << " period_sum=" << Count.PeriodSum << '\n';
+  OS << "IP-STATS input=" << Stats.Input << '\n';
+  for (const auto &[Event, Count] : Stats.Events)
+    OS << "IP-EVENT " << Event << " samples=" << Count << '\n';
+  OS << "IP-STATS after_event=" << Stats.AfterEvent << '\n'
+     << "IP-STATS after_pid=" << Stats.AfterPID << '\n'
+     << "IP-STATS pid_unknown=" << Stats.PIDUnknown << '\n'
+     << "IP-STATS kernel=" << Stats.Kernel << '\n'
+     << "IP-STATS other_dso=" << Stats.OtherDSO << '\n'
+     << "IP-STATS unmapped=" << Stats.Unmapped << '\n'
+     << "IP-STATS target=" << Stats.Target << '\n'
+     << "IP-STATS unmapped_in_target=" << Stats.UnmappedInTarget << '\n'
+     << "IP-STATS lost_records=" << Stats.LostRecords << '\n'
+     << "IP-STATS lost_L=" << Stats.LostCount << '\n'
+     << "IP-STATS mappings=" << Mappings.size() << '\n';
+}
+
+void IPPerfReader::printMmapEvents(raw_ostream &OS) const {
+  for (const IPMapping &M : Mappings)
+    if (M.IsMmap2)
+      OS << M.Raw << '\n';
+}
