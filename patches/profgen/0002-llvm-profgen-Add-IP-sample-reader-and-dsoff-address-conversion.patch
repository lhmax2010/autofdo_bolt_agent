+#ifndef LLVM_TOOLS_LLVM_PROFGEN_IPPERFREADER_H
+#define LLVM_TOOLS_LLVM_PROFGEN_IPPERFREADER_H
+
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/Error.h"
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace llvm {
+class raw_ostream;
+
+struct IPAddressCount {
+  uint64_t SampleCount = 0;
+  uint64_t PeriodSum = 0;
+};
+using AddressCounter = std::map<uint64_t, IPAddressCount>;
+
+/// Observed records, not a pid/fork/exec mapping table. Preserve the raw
+/// identity spelling for later identity validation; do not infer an identity.
+struct IPMapping {
+  int64_t PID = 0, TID = 0;
+  uint64_t Start = 0, Length = 0, PageOffset = 0;
+  bool IsMmap2 = false, Deleted = false;
+  std::string Permissions, Path, BuildID, Device, Inode, Generation, Raw;
+};
+
+struct IPReaderOptions {
+  std::optional<std::string> Event;
+  std::optional<std::string> BinaryMatchRegex;
+  std::optional<uint32_t> PID;
+};
+
+class IPPerfReader {
+  struct Sample {
+    int64_t PID, TID;
+    uint64_t Period, IP;
+    std::optional<uint64_t> Offset;
+    std::string Event, Path;
+    bool Deleted;
+  };
+  struct Segment {
+    uint64_t Offset, End, VAddr;
+  };
+  struct Statistics {
+    uint64_t Input = 0, AfterEvent = 0, AfterPID = 0, PIDUnknown = 0;
+    uint64_t Kernel = 0, OtherDSO = 0, Unmapped = 0, Target = 0;
+    uint64_t UnmappedInTarget = 0, LostRecords = 0, LostCount = 0;
+    std::map<std::string, uint64_t> Events;
+  } Stats;
+
+  std::vector<Sample> Samples;
+  std::vector<IPMapping> Mappings;
+  std::vector<Segment> Segments;
+  AddressCounter Counts;
+  std::string BinaryPath, BinaryRealPath;
+
+  Error parseLine(StringRef Line);
+  Error loadBinary(StringRef Path);
+  Error selectSamples(const IPReaderOptions &Options);
+
+public:
+  Error read(StringRef Trace, StringRef Binary, const IPReaderOptions &Options);
+  const AddressCounter &getAddressCounts() const { return Counts; }
+  const std::vector<IPMapping> &getMappings() const { return Mappings; }
+  void printAddressCounts(raw_ostream &OS) const;
+  void printMmapEvents(raw_ostream &OS) const;
+};
+
+} // namespace llvm
+#endif
