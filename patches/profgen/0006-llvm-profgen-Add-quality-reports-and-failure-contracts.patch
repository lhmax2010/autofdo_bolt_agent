+namespace {
+IPQualityReport *ActiveReport = nullptr;
+Error failure(const Twine &Message) {
+  return createStringError(inconvertibleErrorCode(),
+                           "IP sample mode: " + Message);
+}
+bool decimal(StringRef S, uint64_t &N) {
+  return !S.empty() && llvm::all_of(S, isDigit) && !S.getAsInteger(10, N);
+}
+Expected<std::string> normalized(StringRef Path) {
+  SmallString<256> P(Path);
+  if (std::error_code EC = sys::fs::make_absolute(P))
+    return errorCodeToError(EC);
+  SmallString<256> Parent(sys::path::parent_path(P)), Real;
+  SmallVector<std::string, 8> Tail;
+  Tail.push_back(sys::path::filename(P).str());
+  while (!Parent.empty()) {
+    if (!sys::fs::real_path(Parent, Real))
+      break;
+    Tail.push_back(sys::path::filename(Parent).str());
+    auto Next = sys::path::parent_path(Parent);
+    if (Next == Parent)
+      break;
+    Parent = Next;
+  }
+  if (Real.empty())
+    Real = Parent;
+  for (auto I = Tail.rbegin(); I != Tail.rend(); ++I)
+    sys::path::append(Real, *I);
+  sys::path::remove_dots(Real, true);
+  return Real.str().str();
+}
+Expected<bool> sameFile(StringRef A, StringRef B) {
+  if (sys::fs::exists(A) && sys::fs::exists(B)) {
+    bool Equal;
+    if (std::error_code EC = sys::fs::equivalent(A, B, Equal))
+      return errorCodeToError(EC);
+    return Equal;
+  }
+  auto NA = normalized(A);
+  if (!NA)
+    return NA.takeError();
+  auto NB = normalized(B);
+  if (!NB)
+    return NB.takeError();
+  return *NA == *NB;
+}
+uint64_t weight(const IPAddressCount &C, bool Sample) {
+  return Sample ? C.SampleCount : C.PeriodSum;
+}
+json::Value stringOrUnknown(StringRef S) {
+  return S.empty() ? json::Value("unknown") : json::Value(S);
+}
+} // namespace
