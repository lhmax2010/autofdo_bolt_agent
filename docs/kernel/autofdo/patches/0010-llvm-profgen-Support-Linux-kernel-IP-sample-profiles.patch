+Error IPPerfReader::loadKernelMapping(const ObjectFile &Object) {
+  auto FindAnchor = [&](StringRef Reference) -> Expected<uint64_t> {
+    std::optional<uint64_t> Anchor;
+    for (const SymbolRef &S : Object.symbols()) {
+      auto Name = S.getName();
+      if (!Name)
+        return Name.takeError();
+      if (*Name != Reference)
+        continue;
+      auto Flags = S.getFlags();
+      if (!Flags)
+        return Flags.takeError();
+      if (*Flags & SymbolRef::SF_Undefined)
+        continue;
+      auto Address = S.getAddress();
+      if (!Address)
+        return Address.takeError();
+      if (Anchor && *Anchor != *Address)
+        return invalid("conflicting ELF kernel anchor " + Reference);
+      Anchor = *Address;
+    }
+    if (!Anchor)
+      return invalid("missing ELF kernel anchor " + Reference);
+    if (*Anchor > KernelMaxAddress ||
+        llvm::none_of(Segments, [&](const Segment &Seg) {
+          return *Anchor >= Seg.VAddr &&
+                 *Anchor - Seg.VAddr < Seg.End - Seg.Offset;
+        }))
+      return invalid("ELF kernel anchor is outside executable PT_LOAD");
+    return *Anchor;
+  };
+
+  for (const IPMapping &M : Mappings) {
+    StringRef Reference = livePath(M.Path);
+    if (!Reference.consume_front(KernelDSO))
+      continue;
+    if (Reference != "_text" && Reference != "_stext")
+      return invalid("kernel mmap requires a _text or _stext reference suffix");
+    if (M.Deleted || M.PID != -1)
+      return invalid("expected a live synthesized kernel mmap with pid -1");
+    if (!M.PageOffset)
+      return invalid("missing runtime kernel anchor (zero pgoff)");
+    // Check the last included byte so ARM32 can describe a range ending at
+    // 2^32. parseLine has already validated the 64-bit exclusive end.
+    if (!M.Length || M.PageOffset > KernelMaxAddress ||
+        M.Start + M.Length - 1 > KernelMaxAddress)
+      return invalid("kernel mmap or anchor exceeds the ELF address range");
+    const uint64_t End = M.Start + M.Length;
+    if (M.PageOffset < M.Start || M.PageOffset >= End)
+      return invalid("runtime kernel anchor is outside the kernel mmap");
+    auto Anchor = FindAnchor(Reference);
+    if (!Anchor)
+      return Anchor.takeError();
+    if (KernelMap) {
+      const auto &K = *KernelMap;
+      if (K.Start != M.Start || K.End != End ||
+          translateKernelIP(M.PageOffset, K.RuntimeAnchor, K.LinkAnchor,
+                            KernelMaxAddress) != *Anchor)
+        return invalid("conflicting kernel mmap anchors or ranges; "
+                       "input must come from a single boot");
+    } else {
+      KernelMap =
+          KernelMapping{M.Start, End, M.PageOffset, *Anchor, Reference.str()};
+    }
+  }
+  if (!KernelMap)
+    return invalid("missing synthesized kernel mmap");
+  return Error::success();
+}
