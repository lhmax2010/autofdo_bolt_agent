+//===- IPKernelAddressTest.cpp - Kernel IP relocation tests -------------===//
+//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "../tools/llvm-profgen/IPKernelAddress.h"
+#include "gtest/gtest.h"
+
+using llvm::translateKernelIP;
+
+TEST(IPKernelAddressTest, ZeroSlidePreservesTopArm32Address) {
+  EXPECT_EQ(translateKernelIP(UINT32_MAX, 0xc0008000, 0xc0008000, UINT32_MAX),
+            UINT32_MAX);
+}
+
+TEST(IPKernelAddressTest, PositiveAndNegativeSlide) {
+  EXPECT_EQ(translateKernelIP(0xe0200008, 0xe0008000, 0xc0008000, UINT32_MAX),
+            0xc0200008u);
+  EXPECT_EQ(translateKernelIP(0xbfff0010, 0xc0000000, 0xd0000000, UINT32_MAX),
+            0xcfff0010u);
+}
+
+TEST(IPKernelAddressTest, AArch64HighHalf) {
+  EXPECT_EQ(translateKernelIP(0xffff800030001004ULL, 0xffff800030000000ULL,
+                              0xffff800010000000ULL, UINT64_MAX),
+            0xffff800010001004ULL);
+}
+
+TEST(IPKernelAddressTest, RejectsUnrepresentableResultAndInputs) {
+  EXPECT_EQ(translateKernelIP(0x1000, 0x3000, 0x1000, UINT32_MAX),
+            std::nullopt);
+  EXPECT_EQ(translateKernelIP(0xfffffff0, 0x1000, 0x1020, UINT32_MAX),
+            std::nullopt);
+  EXPECT_EQ(translateKernelIP(UINT64_MAX, 0x1000, 0x1001, UINT64_MAX),
+            std::nullopt);
+  EXPECT_EQ(translateKernelIP(0x100000000ULL, 0x1000, 0x1000, UINT32_MAX),
+            std::nullopt);
+  EXPECT_EQ(translateKernelIP(0x1000, 0x100000000ULL, 0x1000, UINT32_MAX),
+            std::nullopt);
+}
