+namespace {
+Error ipGenerationError(const Twine &Message) {
+  return createStringError(inconvertibleErrorCode(),
+                           "IP sample mode: " + Message);
+}
+Error addIPCount(uint64_t &Value, uint64_t Increment) {
+  auto Sum = checkedAddUnsigned(Value, Increment);
+  if (!Sum)
+    return ipGenerationError("count generation overflow");
+  Value = *Sum;
+  return Error::success();
+}
+uint64_t roundIPCount(uint64_t Numerator, uint64_t Unit) {
+  uint64_t Quotient = Numerator / Unit, Remainder = Numerator % Unit;
+  // Compare without doubling the remainder or adding Unit/2 to Numerator.
+  if (Remainder >= Unit - Remainder)
+    ++Quotient;
+  return Numerator ? std::max<uint64_t>(Quotient, 1) : 0;
+}
+// Validate recursive head sums before using the existing library estimator.
+Expected<uint64_t> checkIPHead(const FunctionSamples &FS) {
+  const auto &Body = FS.getBodySamples();
+  const auto &Calls = FS.getCallsiteSamples();
+  uint64_t Count = 0;
+  if (!Body.empty() &&
+      (Calls.empty() || Body.begin()->first < Calls.begin()->first))
+    Count = Body.begin()->second.getSamples();
+  else if (!Calls.empty())
+    for (const auto &Callee : Calls.begin()->second) {
+      auto Head = checkIPHead(Callee.second);
+      if (!Head)
+        return Head.takeError();
+      if (Error E = addIPCount(Count, *Head))
+        return std::move(E);
+    }
+  return Count ? Count : FS.getTotalSamples() > 0;
+}
