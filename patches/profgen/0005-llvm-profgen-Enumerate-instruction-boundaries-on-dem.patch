diff --git a/llvm/tools/llvm-profgen/IPBoundary.cpp b/llvm/tools/llvm-profgen/IPBoundary.cpp
new file mode 100644
index 000000000000..9ada6e669614
--- /dev/null
+++ b/llvm/tools/llvm-profgen/IPBoundary.cpp
@@ -0,0 +1,245 @@
+//===-- IPBoundary.cpp - On-demand IP instruction boundaries
+//----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "IPBoundary.h"
+#include "llvm/Object/ELFObjectFile.h"
+#include "llvm/Support/CheckedArithmetic.h"
+#include "llvm/Support/Endian.h"
+#include "llvm/Support/Format.h"
+#include "llvm/Support/MathExtras.h"
+
+using namespace llvm;
+using namespace llvm::object;
+using namespace llvm::sampleprof;
+
+namespace {
+Error boundaryError(const Twine &Message) {
+  return createStringError(inconvertibleErrorCode(), Message);
+}
+char mappingISA(StringRef Name, bool ARM) {
+  if (Name.size() < 2 || Name[0] != '$' ||
+      (Name.size() > 2 && (Name[2] != '.' || Name.size() == 3)))
+    return 0;
+  char C = Name[1];
+  return C == 'd' || (ARM ? C == 'a' || C == 't' : C == 'x') ? C : 0;
+}
+} // namespace
+
+Error IPBoundaryMap::loadMappings(StringRef Path, bool Runtime) {
+  auto File = createBinary(Path);
+  if (!File)
+    return File.takeError();
+  auto *Obj = dyn_cast<ELFObjectFileBase>(File->getBinary());
+  if (!Obj ||
+      (!(isa<ELF32LEObjectFile>(Obj) && Obj->getEMachine() == ELF::EM_ARM) &&
+       !(isa<ELF64LEObjectFile>(Obj) && Obj->getEMachine() == ELF::EM_AARCH64)))
+    return boundaryError("requires ELF32 little-endian ARM or ELF64 "
+                         "little-endian AArch64");
+  if (Runtime) {
+    for (const SectionRef &S : Obj->sections()) {
+      if (!(ELFSectionRef(S).getFlags() & ELF::SHF_EXECINSTR) || !S.getSize())
+        continue;
+      auto Name = S.getName();
+      if (!Name)
+        return Name.takeError();
+      auto End = checkedAddUnsigned(S.getAddress(), S.getSize());
+      if (!End)
+        return boundaryError("section address overflow");
+      auto Bytes = S.getContents();
+      if (!Bytes)
+        return Bytes.takeError();
+      if (S.isBSS() || Bytes->size() != S.getSize())
+        return boundaryError("runtime executable section has no bytes");
+      Sections.push_back(
+          {Name->str(), Bytes->str(), S.getAddress(), *End, {}, {}});
+    }
+  }
+  // ELFObjectFileBase::symbols iterates .symtab, not .dynsym.
+  for (ELFSymbolRef Symbol : Obj->symbols()) {
+    auto Name = Symbol.getName();
+    if (!Name)
+      return Name.takeError();
+    char ISA = mappingISA(*Name, Obj->getEMachine() == ELF::EM_ARM);
+    if (!ISA || Symbol.getELFType() != ELF::STT_NOTYPE ||
+        Symbol.getBinding() != ELF::STB_LOCAL)
+      continue;
+    auto SI = Symbol.getSection();
+    if (!SI)
+      return SI.takeError();
+    if (*SI == Obj->section_end())
+      continue;
+    const SectionRef &S = **SI;
+    if (!(ELFSectionRef(S).getFlags() & ELF::SHF_EXECINSTR))
+      continue;
+    auto SN = S.getName();
+    if (!SN)
+      return SN.takeError();
+    auto Address = Symbol.getAddress();
+    if (!Address)
+      return Address.takeError();
+    if (*Address < S.getAddress() || *Address - S.getAddress() >= S.getSize())
+      continue;
+    Section *Match = nullptr;
+    for (auto &Candidate : Sections)
+      if (Candidate.Name == *SN && Candidate.Begin == S.getAddress() &&
+          Candidate.End - Candidate.Begin == S.getSize()) {
+        if (Match)
+          return boundaryError("ambiguous corresponding section " + *SN);
+        Match = &Candidate;
+      }
+    if (!Match)
+      return boundaryError("cannot match section by name and address range: " +
+                           *SN);
+    auto [It, Inserted] = Match->States.emplace(*Address, ISA);
+    if (!Inserted && It->second != ISA)
+      Match->Conflicts.insert(*Address);
+    Sources.insert(Path.str());
+  }
+  return Error::success();
+}
+
+Expected<IPBoundaryMap> IPBoundaryMap::load(StringRef Binary,
+                                            StringRef DebugBinary) {
+  IPBoundaryMap Result;
+  if (Error E = Result.loadMappings(Binary, true))
+    return std::move(E);
+  if (!DebugBinary.empty() && DebugBinary != Binary)
+    if (Error E = Result.loadMappings(DebugBinary, false))
+      return std::move(E);
+  if (Result.Sources.empty())
+    return boundaryError("no usable mapping symbols");
+  return Result;
+}
+
+Expected<IPFunctionBoundaries>
+IPBoundaryMap::enumerate(StringRef Name,
+                         ArrayRef<std::pair<uint64_t, uint64_t>> Ranges,
+                         StringRef SectionName) const {
+  IPFunctionBoundaries Result;
+  Result.Name = Name.str();
+  Result.Ranges.assign(Ranges.begin(), Ranges.end());
+  llvm::sort(Result.Ranges);
+  Result.Ranges.erase(std::unique(Result.Ranges.begin(), Result.Ranges.end()),
+                      Result.Ranges.end());
+  for (size_t RI = 0; RI < Result.Ranges.size(); ++RI) {
+    auto [Begin, End] = Result.Ranges[RI];
+    if (Begin >= End || (RI && Begin < Result.Ranges[RI - 1].second))
+      return boundaryError("invalid or overlapping DWARF ranges");
+    uint64_t Cursor = Begin;
+    while (Cursor < End) {
+      const Section *S = nullptr;
+      for (const auto &Candidate : Sections)
+        if (Cursor >= Candidate.Begin && Cursor < Candidate.End &&
+            (SectionName.empty() || Candidate.Name == SectionName)) {
+          if (S)
+            return boundaryError("ambiguous section for DWARF range");
+          S = &Candidate;
+        }
+      if (!S)
+        return boundaryError("no runtime code section for DWARF range");
+      if (!S->Conflicts.empty())
+        return boundaryError("conflicting mapping states in section " +
+                             S->Name);
+      auto It = S->States.upper_bound(Cursor);
+      if (It == S->States.begin())
+        return boundaryError("no initial mapping state in section " + S->Name);
+      --It;
+      auto Next = std::next(It);
+      uint64_t Stop =
+          std::min(End, Next == S->States.end() ? S->End : Next->first);
+      auto [Anchor, ISA] = *It;
+      Result.Intersections.push_back({Cursor, Stop, Anchor, ISA, S->Name});
+      if (ISA == 'd') {
+        Cursor = Stop;
+        continue;
+      }
+      if (ISA != 't' && ((Cursor % 4) || ((Cursor - Anchor) % 4)))
+        return boundaryError(ISA == 'a'
+                                 ? "bad-arm-start: unaligned A32 range start"
+                                 : "bad-a64-start: unaligned A64 range start");
+      if (ISA == 't' && Anchor % 2)
+        return boundaryError("unaligned Thumb mapping anchor");
+      // Prove a Thumb start from this mapping interval's anchor, never from
+      // an earlier ISA or data interval. Prefix instructions are not emitted.
+      uint64_t PC = ISA == 't' ? Anchor : Cursor;
+      while (PC < Stop) {
+        uint64_t Size = 4;
+        if (ISA == 't') {
+          if (S->End - PC < 2)
+            return boundaryError("truncated Thumb halfword");
+          Size = support::endian::read16le(S->Bytes.data() + PC - S->Begin) >=
+                         0xe800
+                     ? 4
+                     : 2;
+        }
+        if (PC < Cursor && Size > Cursor - PC)
+          return boundaryError(
+              "bad-thumb-start: range starts inside a Thumb instruction");
+        if (Size > Stop - PC)
+          return boundaryError(
+              ISA == 't'   ? "bad-thumb-end: truncated Thumb instruction"
+              : ISA == 'a' ? "bad-arm-end: truncated A32 instruction"
+                           : "bad-a64-end: truncated A64 instruction");
+        if (PC >= Cursor)
+          Result.Instructions.push_back(
+              {PC, Size, RI, Result.Intersections.size() - 1});
+        PC += Size;
+      }
+      Cursor = Stop;
+    }
+  }
+  return Result;
+}
+
+bool IPFunctionBoundaries::contains(uint64_t Address) const {
+  auto It = llvm::lower_bound(
+      Instructions, Address,
+      [](const IPInstruction &I, uint64_t A) { return I.Address < A; });
+  return It != Instructions.end() && It->Address == Address;
+}
+
+uint64_t IPFunctionBoundaries::predecessor(uint64_t Address,
+                                           StringRef &Reason) const {
+  auto It = llvm::lower_bound(
+      Instructions, Address,
+      [](const IPInstruction &I, uint64_t A) { return I.Address < A; });
+  Reason = "first_instruction";
+  if (It == Instructions.end() || It->Address != Address ||
+      It == Instructions.begin())
+    return Address;
+  const auto &Previous = *std::prev(It);
+  if (Previous.RangeIndex != It->RangeIndex) {
+    Reason = "range_gap";
+    return Address;
+  }
+  if (Previous.MappingIndex != It->MappingIndex) {
+    Reason = "data_or_state_change";
+    return Address;
+  }
+  if (Previous.Address + Previous.Size != Address) {
+    Reason = "range_gap";
+    return Address;
+  }
+  Reason = "";
+  return Previous.Address;
+}
+
+void IPFunctionBoundaries::print(raw_ostream &OS) const {
+  OS << "IP-BOUNDARY function=" << Name << '\n';
+  for (auto [Begin, End] : Ranges)
+    OS << "IP-BOUNDARY range=" << format_hex(Begin, 0) << ':'
+       << format_hex(End, 0) << '\n';
+  for (const auto &I : Intersections)
+    OS << "IP-BOUNDARY intersection=" << format_hex(I.Begin, 0) << ':'
+       << format_hex(I.End, 0) << " section=" << I.Section << " isa=$" << I.ISA
+       << " anchor=" << format_hex(I.Anchor, 0) << '\n';
+  for (const auto &I : Instructions)
+    OS << "IP-BOUNDARY instruction=" << format_hex(I.Address, 0)
+       << " size=" << I.Size << " range_index=" << I.RangeIndex << '\n';
+}
diff --git a/llvm/tools/llvm-profgen/IPBoundary.h b/llvm/tools/llvm-profgen/IPBoundary.h
new file mode 100644
index 000000000000..c46754ecc6f6
--- /dev/null
+++ b/llvm/tools/llvm-profgen/IPBoundary.h
@@ -0,0 +1,65 @@
+//===- IPBoundary.h - IP instruction boundaries -----------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_TOOLS_LLVM_PROFGEN_IPBOUNDARY_H
+#define LLVM_TOOLS_LLVM_PROFGEN_IPBOUNDARY_H
+
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/Error.h"
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace llvm {
+namespace sampleprof {
+
+struct IPInstruction {
+  uint64_t Address, Size;
+  size_t RangeIndex, MappingIndex;
+};
+struct IPIntersection {
+  uint64_t Begin, End, Anchor;
+  char ISA;
+  std::string Section;
+};
+struct IPFunctionBoundaries {
+  std::string Name;
+  std::vector<std::pair<uint64_t, uint64_t>> Ranges;
+  std::vector<IPIntersection> Intersections;
+  std::vector<IPInstruction> Instructions;
+  void print(raw_ostream &OS) const;
+  // Return Address and a stable reason when no valid predecessor exists.
+  uint64_t predecessor(uint64_t Address, StringRef &Reason) const;
+  bool contains(uint64_t Address) const;
+};
+
+// Independent of ProfiledBinary's LBR disassembler. Loading mapping metadata
+// and reading instruction bytes are deferred until an IP feature needs them.
+class IPBoundaryMap {
+  struct Section {
+    std::string Name, Bytes;
+    uint64_t Begin, End;
+    std::map<uint64_t, char> States;
+    std::set<uint64_t> Conflicts;
+  };
+  std::vector<Section> Sections;
+  std::set<std::string> Sources;
+  Error loadMappings(StringRef Path, bool Runtime);
+
+public:
+  static Expected<IPBoundaryMap> load(StringRef Binary, StringRef DebugBinary);
+  const std::set<std::string> &sources() const { return Sources; }
+  Expected<IPFunctionBoundaries>
+  enumerate(StringRef Name, ArrayRef<std::pair<uint64_t, uint64_t>> Ranges,
+            StringRef SectionName = "") const;
+};
+} // namespace sampleprof
+} // namespace llvm
+#endif
