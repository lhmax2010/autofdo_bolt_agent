index 000000000000..94d12308eb9a
--- /dev/null
+++ b/llvm/test/tools/llvm-profgen/Inputs/ip-mode/counting.c
@@ -0,0 +1,21 @@
+// Synthetic counting/inlining input: design 5.4, 5.10. No libc.
+static volatile unsigned salt;
+static __attribute__((always_inline)) inline unsigned leaf(unsigned x) {
+  return (x ^ (x >> 7)) * 17u + salt;
+}
+static __attribute__((always_inline)) inline unsigned middle(unsigned x) {
+  return leaf(x) + leaf(x + 3);
+}
+__attribute__((noinline)) unsigned count_loop(volatile unsigned *p, unsigned n) {
+  unsigned sum = 0;
+#pragma unroll 4
+  for (unsigned i = 0; i < n; ++i) sum += p[i] * 3u;
+  return sum;
+}
+__attribute__((noinline)) unsigned two_sites(unsigned x) {
+  unsigned a = middle(x);
+  unsigned b = middle(x + 11);
+  return a + b;
+}
+int main(void) { volatile unsigned a[8] = {1,2,3,4,5,6,7,8};
