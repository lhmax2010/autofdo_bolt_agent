+
+#include "IPPerfReader.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Object/BuildID.h"
+#include "llvm/Object/ELFObjectFile.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/raw_ostream.h"
+#include <algorithm>
+#include <tuple>
+
+using namespace llvm;
+using namespace llvm::object;
+
+namespace {
+Error identityError(const Twine &Message) {
+  return createStringError(inconvertibleErrorCode(),
+                           "IP sample mode: " + Message);
+}
+
+// All text IDs are validated before normalization. Compare every byte, not a
+// fixed-size prefix or an inferred linker-specific ID size.
+std::string hexID(BuildIDRef ID) { return toHex(ID, /*LowerCase=*/true); }
+StringRef displayID(StringRef ID) { return ID.empty() ? "none" : ID; }
+std::string quote(StringRef S) {
+  std::string Result;
+  raw_string_ostream OS(Result);
+  OS << '"';
+  OS.write_escaped(S);
+  OS << '"';
+  return Result;
+}
+StringRef livePath(StringRef P) {
+  P.consume_back(" (deleted)");
+  return P;
+}
+
+enum class Grade { Mismatch, Unverified, VerifiedPath, Verified };
+StringRef name(Grade G) {
+  switch (G) {
+  case Grade::Mismatch:
+    return "mismatch";
+  case Grade::Unverified:
+    return "unverified";
+  case Grade::VerifiedPath:
+    return "verified-path";
+  case Grade::Verified:
+    return "verified";
+  }
+  llvm_unreachable("invalid identity grade");
+}
+
+Expected<std::string> readObjectIdentity(StringRef Path) {
+  auto Object = ObjectFile::createObjectFile(Path);
+  if (!Object)
+    return Object.takeError();
+  const ObjectFile *O = Object->getBinary();
+  if (!isa<ELFObjectFileBase>(O))
+    return identityError("identity input must be an ELF object");
+  // Independent of --use-dwarf-correlation; either section in either object
+  // is sufficient to reject an unadmitted probe build.
+  for (const SectionRef &Section : O->sections()) {
+    auto Name = Section.getName();
+    if (!Name)
+      return Name.takeError();
+    if (*Name == ".pseudo_probe" || *Name == ".pseudo_probe_desc")
+      return createStringError(
+          inconvertibleErrorCode(),
+          "IP sample mode is not admitted for pseudo-probe builds yet; use a "
+          "sampling build without -fpseudo-probe-for-profiling and with "
+          "matching DWARF");
+  }
+  return hexID(getBuildID(O));
+}
+
+using PathIDs = std::map<std::string, std::set<std::string>>;
+Expected<PathIDs> readBuildIDList(StringRef Path) {
+  auto Buffer = MemoryBuffer::getFile(Path);
+  if (!Buffer)
+    return createStringError(Buffer.getError(),
+                             "IP sample mode: cannot read buildid-list");
+  PathIDs Result;
+  StringRef Text = (*Buffer)->getBuffer();
+  unsigned LineNumber = 0;
+  while (!Text.empty()) {
+    auto [Line, Tail] = Text.split('\n');
+    Text = Tail;
+    ++LineNumber;
+    auto Bad = [&]() {
+      return identityError("invalid buildid-list line " + Twine(LineNumber));
+    };
+    if (Line.empty() || Line.contains('\0') || Line.contains('\r'))
+      return Bad();
+    StringRef ID, File;
+    if (Line.front() == ' ' || Line.front() == '\t') {
+      // perf prints a blank ID field followed by the complete DSO path.
+      File = Line.ltrim(" \t");
+    } else {
+      size_t Space = Line.find_first_of(" \t");
+      if (Space == StringRef::npos)
+        return Bad();
+      ID = Line.take_front(Space);
+      if (ID.empty() || ID.size() % 2 || !llvm::all_of(ID, isHexDigit))
+        return Bad();
+      File = Line.drop_front(Space).ltrim(" \t");
+    }
+    if (File.empty())
+      return Bad();
+    auto &IDs = Result[File.str()];
+    if (!ID.empty())
+      IDs.insert(hexID(parseBuildID(ID)));
+  }
+  return Result;
+}
+} // namespace
+
+Error IPPerfReader::validateIdentity(const IPReaderOptions &Options) {
+  bool Observed = llvm::any_of(
+      Mappings, [](const IPMapping &M) { return !M.BuildID.empty(); });
+  IdentityDiagnostics.push_back("observed_mmap_build_id=" +
+                                std::string(Observed ? "true" : "false"));
+  auto ID = readObjectIdentity(BinaryPath);
+  if (!ID)
+    return ID.takeError();
+  BinaryID = *ID;
+  if (Options.DebugBinary) {
+    auto Debug = readObjectIdentity(*Options.DebugBinary);
+    if (!Debug)
+      return Debug.takeError();
+    DebugID = *Debug;
+  }
+  IdentityDiagnostics.push_back("binary=" + quote(BinaryPath) +
+                                " binary_realpath=" + quote(BinaryRealPath) +
+                                " build_id=" + displayID(BinaryID).str());
+  IdentityDiagnostics.push_back(
+      "debug_binary=" +
+      (Options.DebugBinary ? quote(*Options.DebugBinary) : "none") +
+      " build_id=" + displayID(DebugID).str());
+  IdentityDiagnostics.push_back(
+      "selection=" +
+      std::string(Options.BinaryMatchRegex ? "regex" : "basename"));
+
+  PathIDs List;
+  if (Options.BuildIDList) {
+    auto Parsed = readBuildIDList(*Options.BuildIDList);
+    if (!Parsed)
+      return Parsed.takeError();
+    List = std::move(*Parsed);
+  }
+  Grade Overall = Grade::Verified;
+  if (Options.DebugBinary) {
+    if (DebugID != BinaryID)
+      Overall = Grade::Mismatch;
+    IdentityDiagnostics.push_back("source=debug-binary result=" +
+                                  std::string(DebugID != BinaryID ? "mismatch"
+                                              : DebugID.empty()
+                                                  ? "missing"
+                                                  : "consistent"));
+  }
+
+  // Preserve all known conflicts, even in a non-executable mapping. An empty
+  // executable set is missing evidence, not a vacuous successful proof.
+  for (const std::string &Path : Candidates) {
+    const bool Deleted = StringRef(Path).ends_with(" (deleted)");
+    Grade PathGrade = Grade::Verified;
+    auto It = List.find(Path);
+    const std::set<std::string> *IDs = It == List.end() ? nullptr : &It->second;
+    if (IDs)
+      for (const auto &Evidence : *IDs)
+        if (Evidence != BinaryID)
+          PathGrade = Grade::Mismatch;
+    IdentityDiagnostics.push_back("candidate=" + quote(Path) +
+                                  " deleted=" + (Deleted ? "true" : "false"));
+    if (IDs && !IDs->empty()) {
+      for (const auto &Evidence : *IDs)
+        IdentityDiagnostics.push_back(
+            "path=" + quote(Path) +
+            " source=buildid-list origin=unknown build_id=" + Evidence +
+            " result=" + (Evidence == BinaryID ? "consistent" : "mismatch"));
+    } else {
+      IdentityDiagnostics.push_back(
+          "path=" + quote(Path) +
+          " source=buildid-list build_id=none result=missing");
+    }
+    size_t ExecutableCount = 0;
+    for (size_t Index = 0; Index < Mappings.size(); ++Index) {
+      const IPMapping &M = Mappings[Index];
+      if (M.Path != Path)
+        continue;
+      bool Executable = M.Permissions.find('x') != std::string::npos;
+      std::string MappedID =
+          M.BuildID.empty() ? "" : hexID(parseBuildID(M.BuildID));
+      Grade G = Grade::Unverified;
+      StringRef Source = "missing";
+      if (!MappedID.empty()) {
+        Source = "mmap2";
+        G = MappedID == BinaryID ? Grade::Verified : Grade::Mismatch;
+      } else if (!Deleted && IDs && IDs->count(BinaryID) && !BinaryID.empty()) {
+        Source = "buildid-list";
+        G = Grade::VerifiedPath;
+      }
+      if (Executable) {
+        ++ExecutableCount;
+        PathGrade = std::min(PathGrade, G);
+      } else if (G == Grade::Mismatch) {
+        PathGrade = Grade::Mismatch;
+      }
+      IdentityDiagnostics.push_back(
+          "mapping=" + std::to_string(Index) + " path=" + quote(Path) +
+          " pid=" + std::to_string(M.PID) + " executable=" +
+          (Executable ? "true" : "false") + " source=" + Source.str() +
+          " build_id=" + displayID(MappedID).str() + " result=" +
+          (Executable || G == Grade::Mismatch ? name(G).str()
+                                              : "not-required"));
+    }
+    if (!ExecutableCount)
+      PathGrade = std::min(PathGrade, Grade::Unverified);
+    Overall = std::min(Overall, PathGrade);
+    IdentityDiagnostics.push_back(
+        "path=" + quote(Path) + " executable_mappings=" +
+        std::to_string(ExecutableCount) + " result=" + name(PathGrade).str());
+  }
+  // Only candidate paths participate in identity decisions. Retain unrelated
+  // conflicts as diagnostics without changing the target's evidence grade.
+  for (const auto &[Path, IDs] : List)
+    if (IDs.size() > 1) {
+      if (Candidates.count(Path)) {
+        Overall = Grade::Mismatch;
+        IdentityDiagnostics.push_back(
+            "path=" + quote(Path) +
+            " source=buildid-list result=mismatch reason=conflicting-ids");
+      } else {
+        IdentityDiagnostics.push_back("path=" + quote(Path) +
+                                      " unrelated buildid-list conflict");
+      }
+    }
+  IdentityDiagnostics.push_back("final=" + name(Overall).str());
+  if (Overall == Grade::Mismatch)
+    return identityError("build-id mismatch");
+  if (Overall != Grade::Unverified)
+    return Error::success();
+
+  // This is ambiguity detection, not identity proof. Inode fields are parsed
+  // numerically so different zero-padding/case spellings compare equally.
+  std::map<std::string, std::string> Basenames;
+  using InodeKey = std::tuple<uint64_t, uint64_t, uint64_t>;
+  std::map<std::string, std::set<InodeKey>> Inodes;
+  std::map<std::string, std::set<uint64_t>> KnownGenerations;
+  std::map<std::string, unsigned> DeletedStates;
+  bool Ambiguous = false;
+  for (const std::string &Path : Candidates) {
+    std::string Live = livePath(Path).str();
+    std::string Base = sys::path::filename(Live).str();
+    auto [It, Inserted] = Basenames.emplace(Base, Live);
+    Ambiguous |= !Inserted && It->second != Live;
+    for (const IPMapping &M : Mappings) {
+      if (M.Path != Path)
+        continue;
+      DeletedStates[Live] |= M.Deleted ? 2 : 1;
+      if (M.Device.empty())
+        continue;
+      auto [Major, Minor] = StringRef(M.Device).split(':');
+      uint64_t A, B, I, G;
+      // parseLine already validated these fields and their ranges.
+      bool Invalid = Major.getAsInteger(16, A) || Minor.getAsInteger(16, B) ||
+                     StringRef(M.Inode).getAsInteger(10, I) ||
+                     StringRef(M.Generation).getAsInteger(10, G);
+      if (Invalid)
+        return identityError("invalid inode identity");
+      Inodes[Live].insert({A, B, I});
+      // perf's synthesized pre-existing mappings report generation zero,
+      // meaning unknown. Only two unequal known generations conflict.
+      // Inode reuse cannot be detected when one generation is unknown.
+      if (G)
+        KnownGenerations[Live].insert(G);
+    }
+    Ambiguous |= Inodes[Live].size() > 1 || KnownGenerations[Live].size() > 1 ||
+                 DeletedStates[Live] == 3;
+  }
+  if (Ambiguous)
+    return identityError(
+        "ambiguous unverified identity; use --binary-match-regex "
+        "or build-id to distinguish candidates");
+  if (!Options.AllowMissingBuildID)
+    return identityError(
+        "missing build-id evidence; use --allow-missing-build-id "
+        "only for unverified identity");
+  return Error::success();
+}
+
+void IPPerfReader::printIdentity(raw_ostream &OS) const {
+  for (const std::string &Line : IdentityDiagnostics)
+    OS << "IP-IDENTITY " << Line << '\n';
+}
