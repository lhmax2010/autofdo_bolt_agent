 //===----------------------------------------------------------------------===//
 
 #include "ErrorHandling.h"
+#include "IPPerfReader.h"
 #include "Options.h"
 #include "PerfReader.h"
 #include "ProfileGenerator.h"
 #include "ProfiledBinary.h"
