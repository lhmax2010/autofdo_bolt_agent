+//===- IPQualityReport.h - IP quality and output contract ---*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+#ifndef LLVM_TOOLS_LLVM_PROFGEN_IPQUALITYREPORT_H
+#define LLVM_TOOLS_LLVM_PROFGEN_IPQUALITYREPORT_H
+#include "IPPerfReader.h"
+#include "llvm/Support/JSON.h"
+#include <optional>
+namespace llvm {
+namespace sampleprof {
+struct IPGenerationOptions;
+struct IPGenerationStatistics;
+} // namespace sampleprof
+struct IPQualityOptions {
+  std::string Output, Report, Trace, Binary, Debug, BuildIDList, DWP;
+  std::string Injection;
+  std::optional<std::string> MinUsable, MinSamples, MaxLost;
+  std::vector<std::string> Arguments;
+};
+
+/// Call before registering a callback, loading objects, or creating any file.
+Error validateIPOutputPaths(const IPQualityOptions &Options);
+void setIPStage(StringRef Stage);
+bool needsIPQualityCounters();
+bool injectIPFailure(StringRef Point);
+void recordIPWarning(StringRef Code, StringRef Message);
+StringRef getProfgenDWPPath();
+
+class IPQualityReport {
+  IPQualityOptions Options;
+  const IPPerfReader &Reader;
+  const sampleprof::IPGenerationStatistics &Statistics;
+  const sampleprof::IPGenerationOptions &Generation;
+  std::string Stage = "parse", Failure, FailedStage;
+  std::string UsableCheck = "not_evaluated", SampleCheck = "not_evaluated";
+  std::string LostCheck = "not_evaluated";
+  std::map<std::string, std::string> Warnings;
+  std::map<std::string, IPAddressCount> ISACounts, ISASources, OutsideSymbols;
+  uint64_t AlignmentCount = 0, AlignmentPeriod = 0;
+  uint64_t CallbackCount = 0;
+  bool ISAObserved = false, IsA64 = false, ReportIOFailed = false;
+  bool PeriodKnown = false, SemanticsKnown = false;
+  struct Fraction {
+    uint64_t N, D;
+  };
+  std::optional<Fraction> MinUsable, MaxLost;
+  std::optional<uint64_t> MinSamples;
+  json::Value count(const IPAddressCount &C) const;
+  json::Value ratio(uint64_t N, uint64_t D) const;
+  json::Value build();
+  Error writeReport();
+
+public:
+  std::string ProfileTemporary;
+  IPQualityReport(IPQualityOptions Options, const IPPerfReader &Reader,
+                  const sampleprof::IPGenerationStatistics &Statistics,
+                  const sampleprof::IPGenerationOptions &Generation);
+  ~IPQualityReport();
+  bool needsCounters() const {
+    return !Options.Report.empty() || Options.MinUsable || Options.MinSamples ||
+           Options.MaxLost;
+  }
+  void enter(StringRef S) { Stage = S.str(); }
+  bool inject(StringRef Point) const { return Options.Injection == Point; }
+  void warn(StringRef Code, StringRef Message);
+  Error validateOptions();
+  void observeBinary();
+  void setPeriodKnown() { PeriodKnown = true; }
+  void setSemanticsKnown() { SemanticsKnown = true; }
+  Error checkThresholds();
+  Error commitReport();
+  void fail(StringRef Message);
+  void finish();
+};
+} // namespace llvm
+#endif
