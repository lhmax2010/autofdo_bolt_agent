+Expected<bool> ProfiledBinary::loadIPMetadata(ObjectFile &Obj) {
+  // Symbols in a separate debug file may reside in NOBITS sections.
+  for (const SymbolRef &Sym : Obj.symbols()) {
+    auto Name = Sym.getName();
+    if (!Name)
+      return Name.takeError();
+    if (*Name == "__llvm_fs_discriminator__")
+      UseFSDiscriminator = true;
+  }
+  for (const SectionRef &Section : Obj.sections()) {
+    auto Name = Section.getName();
+    if (!Name)
+      return Name.takeError();
+    if (*Name == ".plt" || Name->starts_with(".plt."))
+      IPPLTRanges.emplace_back(Section.getAddress(), Section.getSize());
+  }
+  return true;
+}
