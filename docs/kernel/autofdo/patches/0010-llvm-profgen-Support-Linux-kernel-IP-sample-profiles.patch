+                            [&](const Segment &Seg) {
+                              return *VA >= Seg.VAddr &&
+                                     *VA - Seg.VAddr < Seg.End - Seg.Offset;
+                            })
+           : 0;
+    if (!Matches) {
+      ++OutsideImage;
+      if (Error E = countLayer("outside_image", *S))
+        return E;
+      continue;
+    }
+    auto Exclusion = Boundaries->kernelExclusion(*VA);
+    if (!Exclusion)
+      return Exclusion.takeError();
+    // ARM kernels can link several alternative exception vectors at the
+    // same virtual address. Those sections are excluded as a group.
+    if (Matches > 1 && *Exclusion != "kernel_special_section") {
+      if (Error E = countLayer("unknown_address", *S))
+        return E;
+      return invalid("kernel IP matches multiple executable PT_LOAD segments");
+    }
+    if (!Exclusion->empty()) {
+      if (Error E = countLayer(*Exclusion, *S))
+        return E;
+      continue;
+    }
+    auto &C = Counts[*VA];
+    if (Error E = add(C.SampleCount, 1))
+      return E;
+    if (Error E = add(C.PeriodSum, S->Period))
+      return E;
+  }
+  // Compare integer counts exactly, with no multiplication overflow.
+  if (OutsideImage > Stats.Target / KernelOutsideImageLimitDivisor)
+    return invalid(formatv("{0}/{1} kernel target samples ({2:P3}) are outside "
+                           "the image (limit {3}%). Check the kernel anchor "
+                           "and vmlinux identity",
+                           OutsideImage, Stats.Target,
+                           static_cast<double>(OutsideImage) / Stats.Target,
+                           100 / KernelOutsideImageLimitDivisor)
+                       .str());
+  return Error::success();
+}
