+Error llvm::validateIPOutputPaths(const IPQualityOptions &O) {
+  auto Conflict = [](StringRef A, StringRef AP, StringRef B, StringRef BP) {
+    return failure("path conflict: --" + A + "='" + AP + "' aliases --" + B +
+                   "='" + BP + "'");
+  };
+  if (O.Output == "-")
+    return Conflict("output", "-", "stdout", "-");
+  std::vector<std::pair<StringRef, StringRef>> Outputs{{"output", O.Output}};
+  if (!O.Report.empty())
+    Outputs.emplace_back("quality-report", O.Report);
+  std::vector<std::pair<StringRef, StringRef>> Inputs{
+      {"perfscript", O.Trace},
+      {"binary", O.Binary},
+      {"debug-binary", O.Debug},
+      {"perf-buildid-list", O.BuildIDList},
+      {"dwp", O.DWP}};
+  for (size_t I = 0; I < Outputs.size(); ++I) {
+    StringRef Name = Outputs[I].first;
+    StringRef Path = Outputs[I].second;
+    if (Path.empty())
+      continue;
+    auto Check = [&](StringRef N, StringRef P) -> Error {
+      if (P.empty())
+        return Error::success();
+      auto Same = sameFile(Path, P);
+      if (!Same)
+        return Same.takeError();
+      if (*Same)
+        return Conflict(Name, Path, N, P);
+      return Error::success();
+    };
+    for (size_t J = I + 1; J < Outputs.size(); ++J)
+      if (Error E = Check(Outputs[J].first, Outputs[J].second))
+        return E;
+    for (auto [N, P] : Inputs)
+      if (Error E = Check(N, P))
+        return E;
+  }
+  return Error::success();
+}
+bool llvm::needsIPQualityCounters() {
+  return ActiveReport && ActiveReport->needsCounters();
+}
+void llvm::setIPStage(StringRef S) {
+  if (ActiveReport)
+    ActiveReport->enter(S);
+}
+bool llvm::injectIPFailure(StringRef P) {
+  return ActiveReport && ActiveReport->inject(P);
+}
+void llvm::recordIPWarning(StringRef C, StringRef M) {
+  if (ActiveReport)
+    ActiveReport->warn(C, M);
+}
