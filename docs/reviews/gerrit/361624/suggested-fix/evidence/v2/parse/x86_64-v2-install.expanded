%install
export AR=llvm-ar RANLIB=llvm-ranlib;
export CC=x86_64-tizen-linux-gnu-clang CXX=x86_64-tizen-linux-gnu-clang++;

# ---- A. bolt: install from the standalone build tree ----
cd bolt-build
DESTDIR=/home/linhao/Toolchain/development/llvm_autofdo_bolt_agent/temp/GBS-ROOT-LLVM-RELEASE-20261114c/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILDROOT/llvm-tools-subpkgs-22.1.8-1.x86_64 ninja install
# The internal bolt static libs are build artifacts, not shipped content.
rm -f /home/linhao/Toolchain/development/llvm_autofdo_bolt_agent/temp/GBS-ROOT-LLVM-RELEASE-20261114c/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILDROOT/llvm-tools-subpkgs-22.1.8-1.x86_64/usr/lib64/libLLVMBOLT*.a
# LLVM_LIBDIR_SUFFIX=64 installs the internal archives to lib64 instead.
rm -f /home/linhao/Toolchain/development/llvm_autofdo_bolt_agent/temp/GBS-ROOT-LLVM-RELEASE-20261114c/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILDROOT/llvm-tools-subpkgs-22.1.8-1.x86_64/usr/lib64/libLLVMBOLT*.a
# perf2bolt and llvm-boltdiff are aliases of llvm-bolt: upstream installs them
# as symlinks (bolt/tools/driver/CMakeLists.txt), and llvm-bolt selects its
# mode from the name it is invoked as. Separate copies also collided on
# build-id in the debuginfo step.
ln -sf llvm-bolt /home/linhao/Toolchain/development/llvm_autofdo_bolt_agent/temp/GBS-ROOT-LLVM-RELEASE-20261114c/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILDROOT/llvm-tools-subpkgs-22.1.8-1.x86_64/usr/bin/perf2bolt
ln -sf llvm-bolt /home/linhao/Toolchain/development/llvm_autofdo_bolt_agent/temp/GBS-ROOT-LLVM-RELEASE-20261114c/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILDROOT/llvm-tools-subpkgs-22.1.8-1.x86_64/usr/bin/llvm-boltdiff
# llvm-bat-dump and merge-fdata use add_bolt_executable which carries no
# install rule; stage them manually from the build tree.
install -p -m 0755 bin/llvm-bat-dump /home/linhao/Toolchain/development/llvm_autofdo_bolt_agent/temp/GBS-ROOT-LLVM-RELEASE-20261114c/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILDROOT/llvm-tools-subpkgs-22.1.8-1.x86_64/usr/bin/
install -p -m 0755 bin/merge-fdata   /home/linhao/Toolchain/development/llvm_autofdo_bolt_agent/temp/GBS-ROOT-LLVM-RELEASE-20261114c/local/BUILD-ROOTS/scratch.x86_64.0/home/abuild/rpmbuild/BUILDROOT/llvm-tools-subpkgs-22.1.8-1.x86_64/usr/bin/
cd ..

