+StringRef ProfiledBinary::classifyOutsideIP(uint64_t Address) const {
+  for (auto [Start, Size] : IPPLTRanges)
+    if (Address >= Start && Address - Start < Size)
+      return "plt";
+  for (auto [Start, End] : IPCURanges)
+    if (Address >= Start && Address < End)
+      return "in_cu_no_subprogram";
+  return "no_cu";
+}
